# Environment Configuration
NODE_ENV="production"
PORT=3000

# Frontend URL (For CORS allowed origin)
FRONTEND_URL="https://theiakshi-hrms.onrender.com"
CORS_ORIGIN="https://theiakshi-hrms.onrender.com"

# Frontend API URL (For Vite build)
VITE_API_URL="https://theiakshi-hrms-api.onrender.com/api/v1"

# Neon PostgreSQL Database Connection String
# Example: postgres://neondb_owner:npg_password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://user:password@ep-neon-host.neon.tech/theiakshi_hrms?sslmode=require"

# Fallback PostgreSQL Parameters (If DATABASE_URL is not set)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="theiakshi_hrms"
DB_USER="postgres"
DB_PASSWORD="postgres"

# JWT Security Secrets
JWT_SECRET="your_production_super_secret_jwt_key_2026_change_me"
REFRESH_SECRET="your_production_super_secret_refresh_key_2026_change_me"

# Google Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

