# Environment Configuration
NODE_ENV="development"
PORT=3000

# Frontend URL (For CORS allowed origin)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# Frontend API URL (For Vite build)
VITE_API_URL="http://localhost:3000/api/v1"

# PostgreSQL Database Connection URL (Recommended for Neon/Render production)
DATABASE_URL="postgres://username:password@hostname:5432/dbname?sslmode=require"

# Fallback PostgreSQL Parameters (If DATABASE_URL is not set)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="theiakshi_hrms"
DB_USER="postgres"
DB_PASSWORD="your_database_password_here"

# JWT Security Secrets
JWT_SECRET="your_short_lived_access_token_secret_key_here"
JWT_REFRESH_SECRET="your_long_lived_refresh_token_secret_key_here"

# Google Gemini AI API Key
GEMINI_API_KEY="your_google_gemini_api_key_here"
