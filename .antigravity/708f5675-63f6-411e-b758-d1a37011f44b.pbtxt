    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { PGlite } from \'@electric-sql/pglite\';\nimport { SQL_ENUM_DEFINITIONS } from \'./enums.js\';\n\nexport async function initializeEnterpriseSchema(db: PGlite): Promise<void> {\n  // Execute SQL ENUM Types first\n  await db.exec(SQL_ENUM_DEFINITIONS);\n\n  const schemaStatements = `\n  -- 1. AUTHENTICATION MODULE TABLES\n  CREATE TABLE IF NOT EXISTS roles (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(50) UNIQUE NOT NULL,\n    code VARCHAR(30) UNIQUE NOT NULL,\n    description TEXT,\n    is_system BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS permissions (\n    id SERIAL PRIMARY KEY,\n    module VARCHAR(50) NOT NULL,\n    action VARCHAR(50) NOT NULL,\n    code VARCHAR(100) UNIQUE NOT NULL,\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS role_permissions (\n    id SERIAL PRIMARY KEY,\n    role_id INTEGER NOT NULL REFERENCES roles(id) ON DELETE CASCADE,\n    permission_id INTEGER NOT NULL REFERENCES permissions(id) ON DELETE CASCADE,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL,\n    CONSTRAINT uk_role_permission UNIQUE (role_id, permission_id)\n  );\n\n  -- 2. ORGANIZATION MODULE TABLES\n  CREATE TABLE IF NOT EXISTS branches (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(100) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    address TEXT,\n    city VARCHAR(50),\n    state VARCHAR(50),\n    country VARCHAR(50) DEFAULT \'India\',\n    timezone VARCHAR(50) DEFAULT \'Asia/Kolkata\',\n    is_headquarters BOOLEAN DEFAULT false,\n    is_active BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS departments (\n    id SERIAL PRIMARY KEY,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE SET NULL,\n    name VARCHAR(100) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    description TEXT,\n    manager_id INTEGER DEFAULT NULL,\n    is_active BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS designations (\n    id SERIAL PRIMARY KEY,\n    department_id INTEGER REFERENCES departments(id) ON DELETE SET NULL,\n    title VARCHAR(100) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    grade_level VARCHAR(20),\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS teams (\n    id SERIAL PRIMARY KEY,\n    department_id INTEGER REFERENCES departments(id) ON DELETE CASCADE,\n    lead_id INTEGER DEFAULT NULL,\n    name VARCHAR(100) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS locations (\n    id SERIAL PRIMARY KEY,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n    name VARCHAR(100) NOT NULL,\n    latitude NUMERIC(10, 7),\n    longitude NUMERIC(10, 7),\n    radius_meters INTEGER DEFAULT 200,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS holidays (\n    id SERIAL PRIMARY KEY,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n    name VARCHAR(100) NOT NULL,\n    date DATE NOT NULL,\n    type VARCHAR(30) DEFAULT \'MANDATORY\',\n    description TEXT,\n    is_active BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS week_off_rules (\n    id SERIAL PRIMARY KEY,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n    name VARCHAR(50) NOT NULL,\n    days_of_week VARCHAR(50) DEFAULT \'6,0\', -- Saturday, Sunday\n    alternate_saturdays BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS shifts (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(50) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    start_time TIME NOT NULL,\n    end_time TIME NOT NULL,\n    break_duration_mins INTEGER DEFAULT 60,\n    grace_period_mins INTEGER DEFAULT 15,\n    is_night_shift BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 3. EMPLOYEES & AUTH TABLES\n  CREATE TABLE IF NOT EXISTS employees (\n    id SERIAL PRIMARY KEY,\n    employee_code VARCHAR(20) UNIQUE NOT NULL,\n    email VARCHAR(100) UNIQUE NOT NULL,\n    password_hash VARCHAR(255) NOT NULL,\n    first_name VARCHAR(50) NOT NULL,\n    last_name VARCHAR(50) NOT NULL,\n    phone VARCHAR(20),\n    role VARCHAR(30) DEFAULT \'Employee\',\n    role_id INTEGER REFERENCES roles(id) ON DELETE SET NULL,\n    department_id INTEGER REFERENCES departments(id) ON DELETE SET NULL,\n    designation_id INTEGER REFERENCES designations(id) ON DELETE SET NULL,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE SET NULL,\n    manager_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    shift_id INTEGER REFERENCES shifts(id) ON DELETE SET NULL,\n    status VARCHAR(20) DEFAULT \'ACTIVE\',\n    gender VARCHAR(20) DEFAULT \'PREFER_NOT_TO_SAY\',\n    joining_date DATE NOT NULL,\n    birth_date DATE,\n    address TEXT,\n    avatar_url VARCHAR(255),\n    emergency_contact VARCHAR(20),\n    salary_amount NUMERIC(12,2) DEFAULT 0.00,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS employee_sessions (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    session_token VARCHAR(255) UNIQUE NOT NULL,\n    ip_address VARCHAR(45),\n    user_agent TEXT,\n    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS refresh_tokens (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    token VARCHAR(255) UNIQUE NOT NULL,\n    is_revoked BOOLEAN DEFAULT false,\n    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS login_history (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    email VARCHAR(100) NOT NULL,\n    status VARCHAR(20) NOT NULL, -- SUCCESS, FAILED\n    ip_address VARCHAR(45),\n    user_agent TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS password_reset (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    reset_token VARCHAR(255) UNIQUE NOT NULL,\n    is_used BOOLEAN DEFAULT false,\n    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS otp (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER REFERENCES employees(id) ON DELETE CASCADE,\n    email_or_phone VARCHAR(100) NOT NULL,\n    otp_code VARCHAR(10) NOT NULL,\n    purpose VARCHAR(30) DEFAULT \'LOGIN\',\n    is_verified BOOLEAN DEFAULT false,\n    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 4. ATTENDANCE MODULE TABLES\n  CREATE TABLE IF NOT EXISTS attendance (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    date DATE NOT NULL,\n    punch_in TIMESTAMP WITH TIME ZONE,\n    punch_out TIMESTAMP WITH TIME ZONE,\n    status VARCHAR(20) DEFAULT \'PRESENT\',\n    total_hours NUMERIC(4,2) DEFAULT 0.00,\n    break_hours NUMERIC(4,2) DEFAULT 0.00,\n    overtime_hours NUMERIC(4,2) DEFAULT 0.00,\n    punch_in_latitude NUMERIC(10,7),\n    punch_in_longitude NUMERIC(10,7),\n    punch_out_latitude NUMERIC(10,7),\n    punch_out_longitude NUMERIC(10,7),\n    is_remote BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL,\n    CONSTRAINT uk_employee_attendance_date UNIQUE (employee_id, date)\n  );\n\n  CREATE TABLE IF NOT EXISTS attendance_logs (\n    id SERIAL PRIMARY KEY,\n    attendance_id INTEGER REFERENCES attendance(id) ON DELETE CASCADE,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    punch_time TIMESTAMP WITH TIME ZONE NOT NULL,\n    punch_type VARCHAR(20) NOT NULL, -- IN, OUT, BREAK_START, BREAK_END\n    latitude NUMERIC(10,7),\n    longitude NUMERIC(10,7),\n    device_info VARCHAR(100),\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS attendance_breaks (\n    id SERIAL PRIMARY KEY,\n    attendance_id INTEGER NOT NULL REFERENCES attendance(id) ON DELETE CASCADE,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    start_time TIMESTAMP WITH TIME ZONE NOT NULL,\n    end_time TIMESTAMP WITH TIME ZONE,\n    duration_mins INTEGER DEFAULT 0,\n    break_type VARCHAR(30) DEFAULT \'REGULAR\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS attendance_requests (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    date DATE NOT NULL,\n    requested_punch_in TIMESTAMP WITH TIME ZONE,\n    requested_punch_out TIMESTAMP WITH TIME ZONE,\n    reason TEXT NOT NULL,\n    status VARCHAR(20) DEFAULT \'PENDING\',\n    approver_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS attendance_geofence (\n    id SERIAL PRIMARY KEY,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n    name VARCHAR(100) NOT NULL,\n    center_latitude NUMERIC(10,7) NOT NULL,\n    center_longitude NUMERIC(10,7) NOT NULL,\n    radius_meters INTEGER DEFAULT 300,\n    is_active BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS attendance_device (\n    id SERIAL PRIMARY KEY,\n    branch_id INTEGER REFERENCES branches(id) ON DELETE SET NULL,\n    device_serial VARCHAR(100) UNIQUE NOT NULL,\n    device_name VARCHAR(100) NOT NULL,\n    ip_address VARCHAR(45),\n    is_online BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 5. LEAVE MODULE TABLES\n  CREATE TABLE IF NOT EXISTS leave_types (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(50) NOT NULL,\n    code VARCHAR(10) UNIQUE NOT NULL,\n    description TEXT,\n    color VARCHAR(20) DEFAULT \'#3b82f6\',\n    is_paid BOOLEAN DEFAULT true,\n    max_days_per_year NUMERIC(4,1) DEFAULT 12.0,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS leave_policies (\n    id SERIAL PRIMARY KEY,\n    leave_type_id INTEGER NOT NULL REFERENCES leave_types(id) ON DELETE CASCADE,\n    carry_forward_limit INTEGER DEFAULT 5,\n    monthly_accrual_rate NUMERIC(3,2) DEFAULT 1.00,\n    sandwich_rule_enabled BOOLEAN DEFAULT true,\n    min_service_days INTEGER DEFAULT 0,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS leave_balances (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    leave_type_id INTEGER NOT NULL REFERENCES leave_types(id) ON DELETE CASCADE,\n    total_allocated NUMERIC(4,1) DEFAULT 12.0,\n    used_days NUMERIC(4,1) DEFAULT 0.0,\n    remaining_days NUMERIC(4,1) DEFAULT 12.0,\n    year INTEGER DEFAULT 2026,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL,\n    CONSTRAINT uk_employee_leave_type_year UNIQUE (employee_id, leave_type_id, year)\n  );\n\n  CREATE TABLE IF NOT EXISTS leave_requests (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    leave_type_id INTEGER NOT NULL REFERENCES leave_types(id) ON DELETE CASCADE,\n    start_date DATE NOT NULL,\n    end_date DATE NOT NULL,\n    total_days NUMERIC(4,1) NOT NULL,\n    is_half_day BOOLEAN DEFAULT false,\n    half_day_session VARCHAR(20),\n    reason TEXT NOT NULL,\n    emergency_contact VARCHAR(20),\n    attachment_url VARCHAR(255),\n    status VARCHAR(30) DEFAULT \'MANAGER_PENDING\',\n    approver_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    rejection_reason TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS leave_approvals (\n    id SERIAL PRIMARY KEY,\n    leave_request_id INTEGER NOT NULL REFERENCES leave_requests(id) ON DELETE CASCADE,\n    approver_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    stage_level INTEGER DEFAULT 1, -- 1: Manager, 2: HR\n    action VARCHAR(20) NOT NULL, -- APPROVED, REJECTED\n    comments TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS leave_history (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    leave_type_id INTEGER NOT NULL REFERENCES leave_types(id) ON DELETE CASCADE,\n    change_amount NUMERIC(4,1) NOT NULL,\n    balance_after NUMERIC(4,1) NOT NULL,\n    reason TEXT NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS leave_encashment (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    leave_type_id INTEGER NOT NULL REFERENCES leave_types(id) ON DELETE CASCADE,\n    encashed_days NUMERIC(4,1) NOT NULL,\n    encashment_amount NUMERIC(12,2) NOT NULL,\n    status VARCHAR(20) DEFAULT \'PENDING\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 6. PAYROLL MODULE TABLES\n  CREATE TABLE IF NOT EXISTS salary_structures (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    basic_salary NUMERIC(12,2) NOT NULL,\n    hra NUMERIC(12,2) DEFAULT 0.00,\n    special_allowance NUMERIC(12,2) DEFAULT 0.00,\n    conveyance_allowance NUMERIC(12,2) DEFAULT 0.00,\n    medical_allowance NUMERIC(12,2) DEFAULT 0.00,\n    gross_salary NUMERIC(12,2) NOT NULL,\n    effective_from DATE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS salary_components (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(50) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    type VARCHAR(20) NOT NULL, -- EARNING, DEDUCTION\n    is_taxable BOOLEAN DEFAULT true,\n    is_fixed BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS payroll (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    month VARCHAR(20) NOT NULL,\n    year INTEGER NOT NULL,\n    basic_pay NUMERIC(12,2) NOT NULL,\n    hra NUMERIC(12,2) DEFAULT 0.00,\n    allowances NUMERIC(12,2) DEFAULT 0.00,\n    gross_earnings NUMERIC(12,2) NOT NULL,\n    pf_deduction NUMERIC(12,2) DEFAULT 0.00,\n    esi_deduction NUMERIC(12,2) DEFAULT 0.00,\n    tax_deduction NUMERIC(12,2) DEFAULT 0.00,\n    other_deductions NUMERIC(12,2) DEFAULT 0.00,\n    net_salary NUMERIC(12,2) NOT NULL,\n    status VARCHAR(20) DEFAULT \'DRAFT\',\n    payment_date DATE,\n    generated_by INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL,\n    CONSTRAINT uk_employee_payroll_month_year UNIQUE (employee_id, month, year)\n  );\n\n  CREATE TABLE IF NOT EXISTS payroll_details (\n    id SERIAL PRIMARY KEY,\n    payroll_id INTEGER NOT NULL REFERENCES payroll(id) ON DELETE CASCADE,\n    component_name VARCHAR(50) NOT NULL,\n    component_type VARCHAR(20) NOT NULL,\n    amount NUMERIC(12,2) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS salary_revisions (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    old_salary NUMERIC(12,2) NOT NULL,\n    new_salary NUMERIC(12,2) NOT NULL,\n    percentage_increment NUMERIC(5,2),\n    effective_date DATE NOT NULL,\n    approved_by INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS bonuses (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    title VARCHAR(100) NOT NULL,\n    amount NUMERIC(12,2) NOT NULL,\n    payout_month VARCHAR(20) NOT NULL,\n    payout_year INTEGER NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS deductions (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    title VARCHAR(100) NOT NULL,\n    amount NUMERIC(12,2) NOT NULL,\n    month VARCHAR(20) NOT NULL,\n    year INTEGER NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS tax (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    pan_number VARCHAR(20),\n    regime VARCHAR(10) DEFAULT \'NEW\',\n    tds_amount NUMERIC(12,2) DEFAULT 0.00,\n    financial_year VARCHAR(20) DEFAULT \'2026-2027\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS pf (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    uan_number VARCHAR(20) UNIQUE,\n    pf_number VARCHAR(30) UNIQUE,\n    employee_contribution NUMERIC(12,2) DEFAULT 0.00,\n    employer_contribution NUMERIC(12,2) DEFAULT 0.00,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS esi (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    esi_number VARCHAR(30) UNIQUE,\n    employee_contribution NUMERIC(12,2) DEFAULT 0.00,\n    employer_contribution NUMERIC(12,2) DEFAULT 0.00,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 7. EXPENSE MODULE TABLES\n  CREATE TABLE IF NOT EXISTS expense_categories (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(50) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS expenses (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    category_id INTEGER NOT NULL REFERENCES expense_categories(id) ON DELETE RESTRICT,\n    title VARCHAR(100) NOT NULL,\n    amount NUMERIC(12,2) NOT NULL,\n    expense_date DATE NOT NULL,\n    receipt_url VARCHAR(255),\n    status VARCHAR(20) DEFAULT \'PENDING\',\n    approver_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    notes TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS expense_approvals (\n    id SERIAL PRIMARY KEY,\n    expense_id INTEGER NOT NULL REFERENCES expenses(id) ON DELETE CASCADE,\n    approver_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    action VARCHAR(20) NOT NULL,\n    comments TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS expense_files (\n    id SERIAL PRIMARY KEY,\n    expense_id INTEGER NOT NULL REFERENCES expenses(id) ON DELETE CASCADE,\n    file_name VARCHAR(150) NOT NULL,\n    file_url VARCHAR(255) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 8. PROJECTS MODULE TABLES\n  CREATE TABLE IF NOT EXISTS projects (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(100) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    description TEXT,\n    status VARCHAR(20) DEFAULT \'IN_PROGRESS\',\n    budget NUMERIC(12,2) DEFAULT 0.00,\n    start_date DATE NOT NULL,\n    end_date DATE,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS project_members (\n    id SERIAL PRIMARY KEY,\n    project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    role VARCHAR(30) DEFAULT \'DEVELOPER\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL,\n    CONSTRAINT uk_project_employee UNIQUE (project_id, employee_id)\n  );\n\n  CREATE TABLE IF NOT EXISTS tasks (\n    id SERIAL PRIMARY KEY,\n    project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n    assignee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    title VARCHAR(150) NOT NULL,\n    description TEXT,\n    status VARCHAR(20) DEFAULT \'TODO\',\n    priority VARCHAR(20) DEFAULT \'MEDIUM\',\n    due_date DATE,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS task_comments (\n    id SERIAL PRIMARY KEY,\n    task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    comment TEXT NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS task_files (\n    id SERIAL PRIMARY KEY,\n    task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,\n    file_name VARCHAR(150) NOT NULL,\n    file_url VARCHAR(255) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 9. RECRUITMENT MODULE TABLES\n  CREATE TABLE IF NOT EXISTS jobs (\n    id SERIAL PRIMARY KEY,\n    title VARCHAR(100) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    department_id INTEGER REFERENCES departments(id) ON DELETE SET NULL,\n    location VARCHAR(100),\n    job_type VARCHAR(30) DEFAULT \'FULL_TIME\',\n    positions INTEGER DEFAULT 1,\n    status VARCHAR(20) DEFAULT \'OPEN\',\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS candidates (\n    id SERIAL PRIMARY KEY,\n    job_id INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,\n    first_name VARCHAR(50) NOT NULL,\n    last_name VARCHAR(50) NOT NULL,\n    email VARCHAR(100) NOT NULL,\n    phone VARCHAR(20),\n    resume_url VARCHAR(255),\n    status VARCHAR(30) DEFAULT \'APPLIED\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS interviews (\n    id SERIAL PRIMARY KEY,\n    candidate_id INTEGER NOT NULL REFERENCES candidates(id) ON DELETE CASCADE,\n    interviewer_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    scheduled_at TIMESTAMP WITH TIME ZONE NOT NULL,\n    feedback TEXT,\n    rating INTEGER,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS offers (\n    id SERIAL PRIMARY KEY,\n    candidate_id INTEGER NOT NULL REFERENCES candidates(id) ON DELETE CASCADE,\n    offered_salary NUMERIC(12,2) NOT NULL,\n    joining_date DATE NOT NULL,\n    status VARCHAR(20) DEFAULT \'OFFERED\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 10. ASSETS MODULE TABLES\n  CREATE TABLE IF NOT EXISTS asset_categories (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(50) NOT NULL,\n    code VARCHAR(20) UNIQUE NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS assets (\n    id SERIAL PRIMARY KEY,\n    asset_code VARCHAR(30) UNIQUE NOT NULL,\n    name VARCHAR(100) NOT NULL,\n    category_id INTEGER NOT NULL REFERENCES asset_categories(id) ON DELETE RESTRICT,\n    serial_number VARCHAR(50),\n    purchase_date DATE,\n    value NUMERIC(12,2) DEFAULT 0.00,\n    status VARCHAR(20) DEFAULT \'AVAILABLE\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS asset_allocations (\n    id SERIAL PRIMARY KEY,\n    asset_id INTEGER NOT NULL REFERENCES assets(id) ON DELETE CASCADE,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    allocated_date DATE NOT NULL,\n    returned_date DATE,\n    notes TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS asset_history (\n    id SERIAL PRIMARY KEY,\n    asset_id INTEGER NOT NULL REFERENCES assets(id) ON DELETE CASCADE,\n    event_type VARCHAR(50) NOT NULL,\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 11. HELPDESK MODULE TABLES\n  CREATE TABLE IF NOT EXISTS tickets (\n    id SERIAL PRIMARY KEY,\n    ticket_number VARCHAR(30) UNIQUE NOT NULL,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    subject VARCHAR(150) NOT NULL,\n    category VARCHAR(50) DEFAULT \'IT\',\n    priority VARCHAR(20) DEFAULT \'MEDIUM\',\n    status VARCHAR(20) DEFAULT \'OPEN\',\n    description TEXT NOT NULL,\n    assigned_to INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS ticket_comments (\n    id SERIAL PRIMARY KEY,\n    ticket_id INTEGER NOT NULL REFERENCES tickets(id) ON DELETE CASCADE,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    comment TEXT NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS ticket_attachments (\n    id SERIAL PRIMARY KEY,\n    ticket_id INTEGER NOT NULL REFERENCES tickets(id) ON DELETE CASCADE,\n    file_name VARCHAR(150) NOT NULL,\n    file_url VARCHAR(255) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 12. DOCUMENTS MODULE TABLES\n  CREATE TABLE IF NOT EXISTS employee_documents (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    document_type VARCHAR(50) NOT NULL,\n    document_name VARCHAR(100) NOT NULL,\n    file_url VARCHAR(255) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS company_documents (\n    id SERIAL PRIMARY KEY,\n    title VARCHAR(100) NOT NULL,\n    category VARCHAR(50) DEFAULT \'POLICY\',\n    file_url VARCHAR(255) NOT NULL,\n    is_public BOOLEAN DEFAULT true,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 13. PERFORMANCE MODULE TABLES\n  CREATE TABLE IF NOT EXISTS performance_reviews (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    reviewer_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    review_period VARCHAR(30) NOT NULL,\n    rating NUMERIC(3,2) DEFAULT 0.00,\n    status VARCHAR(20) DEFAULT \'DRAFT\',\n    feedback TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS goals (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    title VARCHAR(150) NOT NULL,\n    description TEXT,\n    target_date DATE,\n    progress_percentage INTEGER DEFAULT 0,\n    status VARCHAR(20) DEFAULT \'IN_PROGRESS\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS kpis (\n    id SERIAL PRIMARY KEY,\n    department_id INTEGER REFERENCES departments(id) ON DELETE CASCADE,\n    title VARCHAR(100) NOT NULL,\n    metric_unit VARCHAR(30),\n    target_value NUMERIC(10,2) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 14. COMMUNICATION MODULE TABLES\n  CREATE TABLE IF NOT EXISTS notifications (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    title VARCHAR(100) NOT NULL,\n    message TEXT NOT NULL,\n    type VARCHAR(30) DEFAULT \'GENERAL\',\n    is_read BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS announcements (\n    id SERIAL PRIMARY KEY,\n    title VARCHAR(150) NOT NULL,\n    content TEXT NOT NULL,\n    priority VARCHAR(20) DEFAULT \'MEDIUM\',\n    published_by INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS messages (\n    id SERIAL PRIMARY KEY,\n    sender_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    receiver_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    content TEXT NOT NULL,\n    is_read BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 15. PLANNING MODULE TABLES\n  CREATE TABLE IF NOT EXISTS weekly_planners (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    week_number INTEGER NOT NULL,\n    year INTEGER NOT NULL,\n    task_title VARCHAR(150) NOT NULL,\n    day_of_week VARCHAR(20) NOT NULL,\n    status VARCHAR(20) DEFAULT \'PENDING\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS timesheets (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n    project_id INTEGER REFERENCES projects(id) ON DELETE SET NULL,\n    task_id INTEGER REFERENCES tasks(id) ON DELETE SET NULL,\n    date DATE NOT NULL,\n    hours_logged NUMERIC(4,2) NOT NULL,\n    description TEXT,\n    status VARCHAR(20) DEFAULT \'SUBMITTED\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS calendar_events (\n    id SERIAL PRIMARY KEY,\n    title VARCHAR(150) NOT NULL,\n    start_time TIMESTAMP WITH TIME ZONE NOT NULL,\n    end_time TIMESTAMP WITH TIME ZONE NOT NULL,\n    location VARCHAR(100),\n    is_all_day BOOLEAN DEFAULT false,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 16. AI MODULE TABLES\n  CREATE TABLE IF NOT EXISTS ai_logs (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    action_type VARCHAR(50) NOT NULL,\n    prompt TEXT,\n    response TEXT,\n    tokens_used INTEGER DEFAULT 0,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS ai_prompts (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(100) UNIQUE NOT NULL,\n    prompt_template TEXT NOT NULL,\n    category VARCHAR(50) DEFAULT \'HR_ASSISTANT\',\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS ai_reports (\n    id SERIAL PRIMARY KEY,\n    report_title VARCHAR(150) NOT NULL,\n    summary TEXT NOT NULL,\n    insights_json TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  -- 17. SYSTEM TABLES\n  CREATE TABLE IF NOT EXISTS settings (\n    id SERIAL PRIMARY KEY,\n    key VARCHAR(100) UNIQUE NOT NULL,\n    value TEXT NOT NULL,\n    category VARCHAR(50) DEFAULT \'GENERAL\',\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS audit_logs (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    action VARCHAR(50) NOT NULL,\n    module VARCHAR(50) NOT NULL,\n    details TEXT,\n    ip_address VARCHAR(45),\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS activity_logs (\n    id SERIAL PRIMARY KEY,\n    employee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n    activity_type VARCHAR(50) NOT NULL,\n    description TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n\n  CREATE TABLE IF NOT EXISTS system_logs (\n    id SERIAL PRIMARY KEY,\n    level VARCHAR(20) DEFAULT \'INFO\',\n    message TEXT NOT NULL,\n    stack_trace TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n    created_by INTEGER DEFAULT NULL,\n    updated_by INTEGER DEFAULT NULL\n  );\n  `;\n\n  await db.exec(schemaStatements);\n}\n"
    }
