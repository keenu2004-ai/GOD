  file_change {
    absolute_path_uri: "file:///src/pages/AttendancePage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Clock,\n  MapPin,\n  CheckCircle2,\n  AlertTriangle,\n  Play,\n  Square,\n  Building2,\n  Calendar,\n} from \'lucide-react\';\nimport apiClient from \'../services/apiClient.js\';\nimport { AttendanceRecord } from \'../types/index.js\';\n\nexport const AttendancePage: React.FC = () => {\n  const [todayRecord, setTodayRecord] = useState<AttendanceRecord | null>(null);\n  const [allToday, setAllToday] = useState<AttendanceRecord[]>([]);\n  const [history, setHistory] = useState<AttendanceRecord[]>([]);\n  const [loading, setLoading] = useState<boolean>(true);\n  const [geofenceDistance, setGeofenceDistance] = useState<number>(24); // 24 meters inside geofence\n\n  const fetchData = async () => {\n    try {\n      setLoading(true);\n      const [statusRes, todayAllRes, historyRes] = await Promise.all([\n        apiClient.get(\'/attendance/status\'),\n        apiClient.get(\'/attendance/today\'),\n        apiClient.get(\'/attendance/history\'),\n      ]);\n\n      if (statusRes.data?.success) setTodayRecord(statusRes.data.data);\n      if (todayAllRes.data?.success) setAllToday(todayAllRes.data.data);\n      if (historyRes.data?.success) setHistory(historyRes.data.data);\n    } catch (err) {\n      console.error(\'Failed to load attendance:\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchData();\n  }, []);\n\n  const handlePunchIn = async () => {\n    try {\n      const res = await apiClient.post(\'/attendance/punch-in\', {\n        latitude: 12.9279,\n        longitude: 77.6892,\n        branch_id: 1,\n      });\n      if (res.data?.success) {\n        alert(\'Punched in successfully via GPS Geofence!\');\n        fetchData();\n      }\n    } catch (err: any) {\n      alert(err.response?.data?.message || \'Punch in failed\');\n    }\n  };\n\n  const handlePunchOut = async () => {\n    try {\n      const res = await apiClient.post(\'/attendance/punch-out\', {\n        latitude: 12.9279,\n        longitude: 77.6892,\n      });\n      if (res.data?.success) {\n        alert(\'Punched out successfully!\');\n        fetchData();\n      }\n    } catch (err: any) {\n      alert(err.response?.data?.message || \'Punch out failed\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Clock className=\"w-6 h-6 text-emerald-400\" />\n            Attendance & Geofenced Punching\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Real-time GPS validation against THEIAKSHI HQ (12.9279\302\260 N, 77.6892\302\260 E).\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 text-xs font-mono\">\n          <MapPin className=\"w-4 h-4 text-emerald-400 animate-bounce\" />\n          <span className=\"text-slate-300\">HQ Distance:</span>\n          <span className=\"text-emerald-400 font-bold\">{geofenceDistance}m (WITHIN GEOFENCE)</span>\n        </div>\n      </div>\n\n      {/* Today Punch Action Card */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-xl\">\n          <div>\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <span className=\"text-xs font-bold text-white uppercase tracking-wider\">Today\'s Punch Status</span>\n              <span className=\"text-[10px] text-blue-400 font-mono\">GENERAL SHIFT</span>\n            </div>\n            <div className=\"mt-4 space-y-2\">\n              <p className=\"text-xs text-slate-400\">\n                Punch In:{\' \'}\n                <span className=\"text-white font-mono font-semibold\">\n                  {todayRecord?.punch_in\n                    ? new Date(todayRecord.punch_in).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n                    : \'Not Punched In\'}\n                </span>\n              </p>\n              <p className=\"text-xs text-slate-400\">\n                Punch Out:{\' \'}\n                <span className=\"text-white font-mono font-semibold\">\n                  {todayRecord?.punch_out\n                    ? new Date(todayRecord.punch_out).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n                    : \'Not Punched Out\'}\n                </span>\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-6 flex gap-3\">\n            {!todayRecord?.punch_in ? (\n              <button\n                onClick={handlePunchIn}\n                className=\"w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl shadow-lg transition-all text-xs\"\n              >\n                <Play className=\"w-4 h-4 fill-white\" />\n                <span>GPS PUNCH IN</span>\n              </button>\n            ) : !todayRecord?.punch_out ? (\n              <button\n                onClick={handlePunchOut}\n                className=\"w-full flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-500 text-white font-bold py-3 rounded-xl shadow-lg transition-all text-xs\"\n              >\n                <Square className=\"w-4 h-4 fill-white\" />\n                <span>GPS PUNCH OUT</span>\n              </button>\n            ) : (\n              <div className=\"w-full text-center py-3 bg-slate-800 text-emerald-400 font-bold rounded-xl text-xs border border-slate-700\">\n                Shift Completed Today\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* All Employees Attendance Table */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl md:col-span-2\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <span className=\"text-xs font-bold text-white uppercase tracking-wider\">Today Employee Attendance Stream</span>\n            <span className=\"text-[10px] text-emerald-400 font-mono\">{allToday.length} Logged Today</span>\n          </div>\n          <div className=\"overflow-x-auto mt-4\">\n            <table className=\"w-full text-left text-xs text-slate-300\">\n              <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px]\">\n                <tr>\n                  <th className=\"p-3\">Employee</th>\n                  <th className=\"p-3\">Punch In</th>\n                  <th className=\"p-3\">Punch Out</th>\n                  <th className=\"p-3\">Work Hours</th>\n                  <th className=\"p-3\">Status</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800/60\">\n                {allToday.map((rec) => (\n                  <tr key={rec.id} className=\"hover:bg-slate-800/40\">\n                    <td className=\"p-3 font-medium text-white\">{rec.first_name} {rec.last_name}</td>\n                    <td className=\"p-3 font-mono text-emerald-400\">\n                      {rec.punch_in ? new Date(rec.punch_in).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }) : \'-\'}\n                    </td>\n                    <td className=\"p-3 font-mono text-blue-400\">\n                      {rec.punch_out ? new Date(rec.punch_out).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }) : \'-\'}\n                    </td>\n                    <td className=\"p-3 font-mono\">{rec.work_hours || 0} hrs</td>\n                    <td className=\"p-3\">\n                      {rec.is_late ? (\n                        <span className=\"bg-amber-500/20 text-amber-300 text-[10px] px-2 py-0.5 rounded font-mono\">LATE</span>\n                      ) : (\n                        <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] px-2 py-0.5 rounded font-mono\">ON TIME</span>\n                      )}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
