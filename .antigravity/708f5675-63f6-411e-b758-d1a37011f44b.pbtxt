    instruction: "Update PayrollPage to Geometric Balance design theme"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <DollarSign className=\"w-6 h-6 text-emerald-400\" />\n            Payroll & Payslip Management\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Itemized salary breakdown, statutory deductions (PF, ESI, TDS) & bank payouts.</p>\n        </div>\n      </div>\n\n      {/* Payroll Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <table className=\"w-full text-left text-xs text-slate-300\">\n          <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px]\">\n            <tr>\n              <th className=\"p-4\">Employee</th>\n              <th className=\"p-4\">Month / Year</th>\n              <th className=\"p-4\">Gross Salary</th>\n              <th className=\"p-4\">Deductions</th>\n              <th className=\"p-4\">Net Payable</th>\n              <th className=\"p-4\">Status</th>\n              <th className=\"p-4 text-right\">Payslip</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {payrolls.map((p) => {\n              const totalDeductions = Number(p.pf_deduction || 0) + Number(p.esi_deduction || 0) + Number(p.tds_deduction || 0);\n              return (\n                <tr key={p.id} className=\"hover:bg-slate-800/40\">\n                  <td className=\"p-4\">\n                    <p className=\"font-bold text-white\">{p.first_name} {p.last_name}</p>\n                    <p className=\"text-[10px] text-slate-400 font-mono\">{p.employee_code}</p>\n                  </td>\n                  <td className=\"p-4 font-mono font-semibold text-blue-400\">{p.month} {p.year}</td>\n                  <td className=\"p-4 font-mono\">\342\202\271{Number(p.gross_salary || 0).toLocaleString(\'en-IN\')}</td>\n                  <td className=\"p-4 font-mono text-rose-400\">-\342\202\271{totalDeductions.toLocaleString(\'en-IN\')}</td>\n                  <td className=\"p-4 font-mono font-bold text-emerald-400\">\342\202\271{Number(p.net_salary || 0).toLocaleString(\'en-IN\')}</td>\n                  <td className=\"p-4\">\n                    <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">\n                      {p.payment_status}\n                    </span>\n                  </td>\n                  <td className=\"p-4 text-right\">\n                    <button\n                      onClick={() => setSelectedPayslip(p)}\n                      className=\"p-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium ml-auto\"\n                    >\n                      <Eye className=\"w-3.5 h-3.5\" />\n                      <span>View Payslip</span>\n                    </button>\n                  </td>\n                </tr>\n              );\n            })}\n          </tbody>\n        </table>\n      </div>\n\n      {/* Itemized Payslip Modal */}\n      {selectedPayslip && (\n        <div className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-2xl space-y-6 shadow-2xl\">\n            <div className=\"flex justify-between items-center border-b border-slate-800 pb-4\">\n              <div>\n                <h3 className=\"text-lg font-bold text-white\">THEIAKSHI ENTERPRISES</h3>\n                <p className=\"text-xs text-blue-400 font-mono\">CONFIDENTIAL SALARY PAYSLIP \342\200\242 {selectedPayslip.month} {selectedPayslip.year}</p>\n              </div>\n              <button onClick={() => setSelectedPayslip(null)} className=\"text-slate-400 hover:text-white\"><X className=\"w-5 h-5\" /></button>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4 bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs\">\n              <div>\n                <p className=\"text-slate-500\">Employee Name:</p>\n                <p className=\"font-bold text-white\">{selectedPayslip.first_name} {selectedPayslip.last_name}</p>\n                <p className=\"text-slate-500 mt-2\">Designation:</p>\n                <p className=\"font-bold text-white\">{selectedPayslip.designation}</p>\n              </div>\n              <div>\n                <p className=\"text-slate-500\">Bank Account:</p>\n                <p className=\"font-mono font-bold text-emerald-400\">{selectedPayslip.bank_account || \'918237192890\'}</p>\n                <p className=\"text-slate-500 mt-2\">IFSC Code:</p>\n                <p className=\"font-mono font-bold text-white\">{selectedPayslip.ifsc_code || \'HDFC0001234\'}</p>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-6 text-xs\">\n              {/* Earnings */}\n              <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n                <p className=\"font-bold text-emerald-400 border-b border-slate-800 pb-2\">EARNINGS (\342\202\271)</p>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">Basic Salary:</span><span className=\"font-mono text-white\">\342\202\271{Number(selectedPayslip.basic_salary).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">House Rent Allowance (HRA):</span><span className=\"font-mono text-white\">\342\202\271{Number(selectedPayslip.hra).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">Conveyance Allowance:</span><span className=\"font-mono text-white\">\342\202\271{Number(selectedPayslip.conveyance).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">Special Allowances:</span><span className=\"font-mono text-white\">\342\202\271{Number(selectedPayslip.allowances).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between font-bold text-emerald-400 pt-2 border-t border-slate-800\">\n                  <span>Gross Earnings:</span>\n                  <span className=\"font-mono\">\342\202\271{Number(selectedPayslip.gross_salary).toLocaleString(\'en-IN\')}</span>\n                </div>\n              </div>\n\n              {/* Deductions */}\n              <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n                <p className=\"font-bold text-rose-400 border-b border-slate-800 pb-2\">STATUTORY DEDUCTIONS (\342\202\271)</p>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">Provident Fund (PF):</span><span className=\"font-mono text-rose-300\">\342\202\271{Number(selectedPayslip.pf_deduction).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">Employee State Insurance (ESI):</span><span className=\"font-mono text-rose-300\">\342\202\271{Number(selectedPayslip.esi_deduction).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between\"><span className=\"text-slate-400\">Tax Deducted at Source (TDS):</span><span className=\"font-mono text-rose-300\">\342\202\271{Number(selectedPayslip.tds_deduction).toLocaleString(\'en-IN\')}</span></div>\n                <div className=\"flex justify-between font-bold text-rose-400 pt-6 border-t border-slate-800\">\n                  <span>Total Deductions:</span>\n                  <span className=\"font-mono\">\342\202\271{(Number(selectedPayslip.pf_deduction) + Number(selectedPayslip.esi_deduction) + Number(selectedPayslip.tds_deduction)).toLocaleString(\'en-IN\')}</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-emerald-950/60 border border-emerald-500/30 p-4 rounded-xl flex justify-between items-center text-sm font-bold\">\n              <span className=\"text-emerald-300\">NET SALARY DISBURSED TO BANK:</span>\n              <span className=\"text-xl text-emerald-400 font-mono\">\342\202\271{Number(selectedPayslip.net_salary).toLocaleString(\'en-IN\')}</span>\n            </div>\n\n            <div className=\"flex justify-end gap-2\">\n              <button onClick={() => window.print()} className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-lg flex items-center gap-1.5\">\n                <Download className=\"w-4 h-4\" />\n                <span>Download PDF</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      )}"
