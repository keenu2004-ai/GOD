  file_change {
    absolute_path_uri: "file:///src/pages/WeeklyPlannerPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Calendar, Sparkles, CheckSquare, Plus, Send, Bot, User } from \'lucide-react\';\nimport apiClient from \'../services/apiClient.js\';\n\nexport const WeeklyPlannerPage: React.FC = () => {\n  const [tasks, setTasks] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchPlanner = async () => {\n      try {\n        const res = await apiClient.get(\'/planner\');\n        if (res.data?.success) setTasks(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchPlanner();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800\">\n        <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n          <Calendar className=\"w-6 h-6 text-indigo-400\" />\n          Weekly Work Planner\n        </h2>\n        <p className=\"text-xs text-slate-400 mt-1\">Organize weekly sprint deliverables and priority commitments.</p>\n      </div>\n\n      <div className=\"space-y-3\">\n        {tasks.map((t) => (\n          <div key={t.id} className=\"bg-slate-900 border border-slate-800 rounded-xl p-4 flex justify-between items-center text-xs\">\n            <div>\n              <p className=\"font-bold text-white\">{t.title}</p>\n              <p className=\"text-slate-400 mt-0.5\">{t.description}</p>\n            </div>\n            <span className=\"bg-blue-500/20 text-blue-300 font-mono text-[10px] px-2 py-0.5 rounded font-bold\">{t.status}</span>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport const AIAssistantPage: React.FC = () => {\n  const [query, setQuery] = useState<string>(\'\');\n  const [messages, setMessages] = useState<any[]>([\n    {\n      sender: \'bot\',\n      text: \'Hello Executive! I am THEIAKSHI ONE HR Intelligence AI powered by Gemini models. How can I assist you with workforce analytics, leave policy compliance, or attendance forecasting today?\',\n    },\n  ]);\n  const [loading, setLoading] = useState<boolean>(false);\n\n  const handleSend = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!query.trim()) return;\n\n    const userText = query;\n    setMessages((prev) => [...prev, { sender: \'user\', text: userText }]);\n    setQuery(\'\');\n    setLoading(true);\n\n    try {\n      const res = await apiClient.post(\'/dashboard/ai-insights\', { query: userText });\n      if (res.data?.success) {\n        setMessages((prev) => [...prev, { sender: \'bot\', text: res.data.data.insights }]);\n      }\n    } catch (err) {\n      setMessages((prev) => [...prev, { sender: \'bot\', text: \'Error connecting to Gemini AI Engine.\' }]);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-4xl mx-auto\">\n      <div className=\"bg-gradient-to-r from-blue-900/60 to-indigo-900/60 border border-indigo-700/60 p-5 rounded-2xl flex items-center gap-3\">\n        <Sparkles className=\"w-8 h-8 text-amber-300 animate-bounce\" />\n        <div>\n          <h2 className=\"text-lg font-bold text-white\">THEIAKSHI ONE HR Executive AI Assistant</h2>\n          <p className=\"text-xs text-indigo-200\">Server-side Gemini 3.6 Flash Integration for Enterprise HR Analytics</p>\n        </div>\n      </div>\n\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl h-[480px] flex flex-col justify-between p-4 shadow-2xl\">\n        <div className=\"flex-1 overflow-y-auto space-y-3 p-2\">\n          {messages.map((m, idx) => (\n            <div key={idx} className={`flex items-start gap-3 ${m.sender === \'user\' ? \'justify-end\' : \'justify-start\'}`}>\n              {m.sender === \'bot\' && <div className=\"w-8 h-8 rounded-xl bg-indigo-600 flex items-center justify-center shrink-0\"><Bot className=\"w-4 h-4 text-white\" /></div>}\n              <div className={`p-3.5 rounded-2xl max-w-lg text-xs leading-relaxed ${m.sender === \'user\' ? \'bg-blue-600 text-white\' : \'bg-slate-950 text-slate-200 border border-slate-800\'}`}>\n                {m.text}\n              </div>\n              {m.sender === \'user\' && <div className=\"w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center shrink-0\"><User className=\"w-4 h-4 text-white\" /></div>}\n            </div>\n          ))}\n          {loading && <p className=\"text-xs text-indigo-400 font-mono animate-pulse\">Gemini AI generating response...</p>}\n        </div>\n\n        <form onSubmit={handleSend} className=\"flex gap-2 pt-3 border-t border-slate-800\">\n          <input\n            type=\"text\"\n            placeholder=\"Ask about retention rates, attendance anomalies, or payroll budgets...\"\n            value={query}\n            onChange={(e) => setQuery(e.target.value)}\n            className=\"flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n          />\n          <button type=\"submit\" className=\"bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-xl font-bold text-xs flex items-center gap-1.5\">\n            <Send className=\"w-4 h-4\" />\n            <span>Send</span>\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
