    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { UserPlus, Laptop, Briefcase, Plus, CheckCircle, Clock } from \'lucide-react\';\nimport apiClient from \'../services/apiClient.js\';\n\nexport const RecruitmentPage: React.FC = () => {\n  const [jobs, setJobs] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchJobs = async () => {\n      try {\n        const res = await apiClient.get(\'/recruitments\');\n        if (res.data?.success) setJobs(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchJobs();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <UserPlus className=\"w-6 h-6 text-purple-400\" />\n            Recruitment & Applicant Tracking (ATS)\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Manage active corporate requisitions, candidate pipelines & interviews.</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {jobs.map((job) => (\n          <div key={job.id} className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3\">\n            <div className=\"flex justify-between items-start\">\n              <div>\n                <span className=\"text-[10px] text-purple-400 font-mono font-bold\">{job.job_code}</span>\n                <h3 className=\"font-bold text-white text-base mt-0.5\">{job.title}</h3>\n                <p className=\"text-xs text-slate-400\">{job.department_name} \342\200\242 {job.experience_level}</p>\n              </div>\n              <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">\n                {job.status}\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-300\">{job.description}</p>\n            <div className=\"flex justify-between items-center pt-2 text-xs font-mono border-t border-slate-800\">\n              <span className=\"text-slate-400\">Positions Open: <strong className=\"text-white\">{job.positions_count}</strong></span>\n              <span className=\"text-emerald-400 font-bold\">CTC: \342\202\271{(job.salary_range_max/100000).toFixed(1)} LPA</span>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport const AssetsPage: React.FC = () => {\n  const [assets, setAssets] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchAssets = async () => {\n      try {\n        const res = await apiClient.get(\'/assets\');\n        if (res.data?.success) setAssets(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchAssets();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Laptop className=\"w-6 h-6 text-cyan-400\" />\n            IT & Company Hardware Asset Tracking\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Enterprise hardware inventory, serial numbers & employee allocations.</p>\n        </div>\n      </div>\n\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <table className=\"w-full text-left text-xs text-slate-300\">\n          <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px]\">\n            <tr>\n              <th className=\"p-4\">Asset Code / Model</th>\n              <th className=\"p-4\">Category</th>\n              <th className=\"p-4\">Serial Number</th>\n              <th className=\"p-4\">Assigned Employee</th>\n              <th className=\"p-4\">Status</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {assets.map((ast) => (\n              <tr key={ast.id} className=\"hover:bg-slate-800/40\">\n                <td className=\"p-4\">\n                  <p className=\"font-bold text-white\">{ast.name}</p>\n                  <p className=\"text-[10px] text-cyan-400 font-mono\">{ast.asset_code}</p>\n                </td>\n                <td className=\"p-4 font-mono\">{ast.category}</td>\n                <td className=\"p-4 font-mono text-slate-400\">{ast.serial_number}</td>\n                <td className=\"p-4 font-semibold text-slate-200\">\n                  {ast.first_name ? `${ast.first_name} ${ast.last_name}` : \'Unassigned\'}\n                </td>\n                <td className=\"p-4\">\n                  <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">\n                    {ast.status}\n                  </span>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n};\n"
    }
