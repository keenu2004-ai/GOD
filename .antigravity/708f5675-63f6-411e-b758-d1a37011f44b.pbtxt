      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <CalendarCheck2 className=\"w-6 h-6 text-amber-400\" />\n            Leave & Time-Off Management\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Submit leave requests and monitor entitlement balances.</p>\n        </div>\n        <button\n          onClick={() => setShowApplyModal(true)}\n          className=\"bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center gap-2 shadow-lg\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Apply Leave</span>\n        </button>\n      </div>\n\n      {/* Leave Balances Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        {balances.map((b: any) => (\n          <div key={b.id} className=\"bg-slate-900 border border-slate-800 p-4 rounded-2xl\">\n            <span className=\"text-xs font-bold text-slate-400 uppercase\">{b.leave_type_name}</span>\n            <div className=\"flex items-baseline justify-between mt-2\">\n              <span className=\"text-2xl font-bold text-white font-mono\">{b.balance_days} Days</span>\n              <span className=\"text-xs text-slate-500\">Allocated: {b.allocated_days}</span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Leave Applications Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <table className=\"w-full text-left text-xs text-slate-300\">\n          <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px]\">\n            <tr>\n              <th className=\"p-4\">Employee</th>\n              <th className=\"p-4\">Leave Type</th>\n              <th className=\"p-4\">Dates</th>\n              <th className=\"p-4\">Days</th>\n              <th className=\"p-4\">Reason</th>\n              <th className=\"p-4\">Status</th>\n              <th className=\"p-4 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {leaves.map((l) => (\n              <tr key={l.id} className=\"hover:bg-slate-800/40\">\n                <td className=\"p-4 font-semibold text-white\">{l.first_name} {l.last_name}</td>\n                <td className=\"p-4 text-blue-400 font-mono font-bold\">{l.leave_type_name}</td>\n                <td className=\"p-4 font-mono\">{l.start_date} to {l.end_date}</td>\n                <td className=\"p-4 font-mono font-bold\">{l.total_days}</td>\n                <td className=\"p-4 max-w-xs truncate\">{l.reason}</td>\n                <td className=\"p-4\">\n                  <span\n                    className={`text-[10px] font-bold px-2 py-0.5 rounded border ${\n                      l.status === \'APPROVED\'\n                        ? \'bg-emerald-500/20 text-emerald-400 border-emerald-500/30\'\n                        : l.status === \'REJECTED\'\n                        ? \'bg-rose-500/20 text-rose-400 border-rose-500/30\'\n                        : \'bg-amber-500/20 text-amber-300 border-amber-500/30\'\n                    }`}\n                  >\n                    {l.status}\n                  </span>\n                </td>\n                <td className=\"p-4 text-right space-x-1\">\n                  {l.status === \'PENDING\' && (\n                    <>\n                      <button onClick={() => handleStatusUpdate(l.id, \'APPROVED\')} className=\"p-1.5 bg-emerald-950 text-emerald-400 hover:bg-emerald-900 rounded-lg\">\n                        <Check className=\"w-4 h-4\" />\n                      </button>\n                      <button onClick={() => handleStatusUpdate(l.id, \'REJECTED\')} className=\"p-1.5 bg-rose-950 text-rose-400 hover:bg-rose-900 rounded-lg\">\n                        <X className=\"w-4 h-4\" />\n                      </button>\n                    </>\n                  )}\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n\n      {/* Apply Leave Modal */}\n      {showApplyModal && (\n        <div className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md space-y-4\">\n            <h3 className=\"text-base font-bold text-white\">Apply For Leave</h3>\n            <form onSubmit={handleApply} className=\"space-y-3 text-xs\">\n              <div>\n                <label className=\"text-slate-400\">Leave Type</label>\n                <select\n                  value={formData.leave_type_id}\n                  onChange={(e) => setFormData({ ...formData, leave_type_id: Number(e.target.value) })}\n                  className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\"\n                >\n                  <option value={1}>Casual Leave (CL)</option>\n                  <option value={2}>Sick Leave (SL)</option>\n                  <option value={3}>Privilege Leave (PL)</option>\n                </select>\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-slate-400\">Start Date</label>\n                  <input type=\"date\" value={formData.start_date} onChange={(e) => setFormData({ ...formData, start_date: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n                <div>\n                  <label className=\"text-slate-400\">End Date</label>\n                  <input type=\"date\" value={formData.end_date} onChange={(e) => setFormData({ ...formData, end_date: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n              </div>\n              <div>\n                <label className=\"text-slate-400\">Reason</label>\n                <textarea rows={3} value={formData.reason} onChange={(e) => setFormData({ ...formData, reason: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n              </div>\n              <div className=\"flex justify-end gap-2 pt-2\">\n                <button type=\"button\" onClick={() => setShowApplyModal(false)} className=\"px-4 py-2 bg-slate-800 text-slate-300 rounded-lg\">Cancel</button>\n                <button type=\"submit\" className=\"px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-lg\">Submit Request</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
        replacement_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <CalendarCheck2 className=\"w-6 h-6 text-amber-500\" />\n            Leave & Time-Off Management\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-1\">Submit leave requests and monitor entitlement balances.</p>\n        </div>\n        <button\n          onClick={() => setShowApplyModal(true)}\n          className=\"bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm transition-all\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Apply Leave</span>\n        </button>\n      </div>\n\n      {/* Leave Balances Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        {balances.map((b: any) => (\n          <div key={b.id} className=\"bg-white border border-slate-200 p-5 rounded-xl shadow-sm\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-tight\">{b.leave_type_name}</span>\n            <div className=\"flex items-baseline justify-between mt-2\">\n              <span className=\"text-3xl font-black text-slate-900 font-sans\">{b.balance_days} Days</span>\n              <span className=\"text-xs text-slate-400 font-medium\">Allocated: {b.allocated_days}</span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Leave Applications Table */}\n      <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm\">\n        <table className=\"w-full text-left text-xs text-slate-700\">\n          <thead className=\"bg-slate-50 text-slate-500 border-b border-slate-200 uppercase text-[10px] font-black tracking-wider\">\n            <tr>\n              <th className=\"p-4\">Employee</th>\n              <th className=\"p-4\">Leave Type</th>\n              <th className=\"p-4\">Dates</th>\n              <th className=\"p-4\">Days</th>\n              <th className=\"p-4\">Reason</th>\n              <th className=\"p-4\">Status</th>\n              <th className=\"p-4 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {leaves.map((l) => (\n              <tr key={l.id} className=\"hover:bg-slate-50\">\n                <td className=\"p-4 font-bold text-slate-900\">{l.first_name} {l.last_name}</td>\n                <td className=\"p-4 text-blue-600 font-mono font-bold\">{l.leave_type_name}</td>\n                <td className=\"p-4 font-mono font-medium\">{l.start_date} to {l.end_date}</td>\n                <td className=\"p-4 font-mono font-bold text-slate-900\">{l.total_days}</td>\n                <td className=\"p-4 max-w-xs truncate text-slate-600\">{l.reason}</td>\n                <td className=\"p-4\">\n                  <span\n                    className={`text-[10px] font-bold px-2 py-0.5 rounded ${\n                      l.status === \'APPROVED\'\n                        ? \'bg-emerald-100 text-emerald-800 border border-emerald-200\'\n                        : l.status === \'REJECTED\'\n                        ? \'bg-rose-100 text-rose-700 border border-rose-200\'\n                        : \'bg-orange-100 text-orange-700 border border-orange-200\'\n                    }`}\n                  >\n                    {l.status}\n                  </span>\n                </td>\n                <td className=\"p-4 text-right space-x-1\">\n                  {l.status === \'PENDING\' && (\n                    <>\n                      <button onClick={() => handleStatusUpdate(l.id, \'APPROVED\')} className=\"p-1.5 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 rounded-lg transition-colors\">\n                        <Check className=\"w-4 h-4\" />\n                      </button>\n                      <button onClick={() => handleStatusUpdate(l.id, \'REJECTED\')} className=\"p-1.5 bg-rose-100 text-rose-700 hover:bg-rose-200 rounded-lg transition-colors\">\n                        <X className=\"w-4 h-4\" />\n                      </button>\n                    </>\n                  )}\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n\n      {/* Apply Leave Modal */}\n      {showApplyModal && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white border border-slate-200 rounded-xl p-6 w-full max-w-md space-y-4 shadow-2xl text-slate-900\">\n            <h3 className=\"text-base font-bold text-slate-900\">Apply For Leave</h3>\n            <form onSubmit={handleApply} className=\"space-y-3 text-xs\">\n              <div>\n                <label className=\"text-slate-600 font-semibold\">Leave Type</label>\n                <select\n                  value={formData.leave_type_id}\n                  onChange={(e) => setFormData({ ...formData, leave_type_id: Number(e.target.value) })}\n                  className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\"\n                >\n                  <option value={1}>Casual Leave (CL)</option>\n                  <option value={2}>Sick Leave (SL)</option>\n                  <option value={3}>Privilege Leave (PL)</option>\n                </select>\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-slate-600 font-semibold\">Start Date</label>\n                  <input type=\"date\" value={formData.start_date} onChange={(e) => setFormData({ ...formData, start_date: e.target.value })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n                </div>\n                <div>\n                  <label className=\"text-slate-600 font-semibold\">End Date</label>\n                  <input type=\"date\" value={formData.end_date} onChange={(e) => setFormData({ ...formData, end_date: e.target.value })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n                </div>\n              </div>\n              <div>\n                <label className=\"text-slate-600 font-semibold\">Reason</label>\n                <textarea rows={3} value={formData.reason} onChange={(e) => setFormData({ ...formData, reason: e.target.value })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n              </div>\n              <div className=\"flex justify-end gap-2 pt-2\">\n                <button type=\"button\" onClick={() => setShowApplyModal(false)} className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg\">Cancel</button>\n                <button type=\"submit\" className=\"px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg shadow-sm\">Submit Request</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
      }
      num_matches: 1
    }
  }
}
