it\', minute: \'2-digit\' })\n                    : \'Not Punched In\'}\n                </span>\n              </p>\n              <p className=\"text-xs text-slate-600\">\n                Punch Out:{\' \'}\n                <span className=\"text-slate-900 font-mono font-bold\">\n                  {todayRecord?.punch_out\n                    ? new Date(todayRecord.punch_out).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n                    : \'Not Punched Out\'}\n                </span>\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-6 flex gap-3\">\n            {!todayRecord?.punch_in ? (\n              <button\n                onClick={handlePunchIn}\n                className=\"w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-lg shadow-sm transition-all text-xs\"\n              >\n                <Play className=\"w-4 h-4 fill-white\" />\n                <span>GPS PUNCH IN</span>\n              </button>\n            ) : !todayRecord?.punch_out ? (\n              <button\n                onClick={handlePunchOut}\n                className=\"w-full flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-bold py-3 rounded-lg shadow-sm transition-all text-xs\"\n              >\n                <Square className=\"w-4 h-4 fill-white\" />\n                <span>GPS PUNCH OUT</span>\n              </button>"
