    instruction: "Update EmployeesPage styling to match Geometric Balance theme"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 p-5 rounded-2xl border border-slate-800\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Users className=\"w-6 h-6 text-blue-500\" />\n            Employees Directory\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Manage enterprise headcount, payroll bank accounts, emergency contacts, and status.\n          </p>\n        </div>\n        <button\n          onClick={() => setShowCreateModal(true)}\n          className=\"flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-lg transition-all\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Employee</span>\n        </button>\n      </div>\n\n      {/* Filters & Search */}\n      <div className=\"flex flex-col sm:flex-row items-center gap-3 bg-slate-900/60 p-4 rounded-xl border border-slate-800\">\n        <div className=\"relative flex-1 w-full\">\n          <Search className=\"w-4 h-4 absolute left-3 top-3 text-slate-500\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by name, code, email or designation...\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            className=\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500\"\n          />\n        </div>\n        <select\n          value={roleFilter}\n          onChange={(e) => setRoleFilter(e.target.value)}\n          className=\"bg-slate-950 border border-slate-800 text-xs text-white rounded-lg px-3 py-2 w-full sm:w-48 focus:outline-none focus:border-blue-500\"\n        >\n          <option value=\"\">All Roles</option>\n          <option value=\"ADMIN\">ADMIN</option>\n          <option value=\"HR_MANAGER\">HR_MANAGER</option>\n          <option value=\"DEPT_HEAD\">DEPT_HEAD</option>\n          <option value=\"EMPLOYEE\">EMPLOYEE</option>\n        </select>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs text-slate-300\">\n            <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-800\">\n              <tr>\n                <th className=\"p-4\">Employee</th>\n                <th className=\"p-4\">Code / Role</th>\n                <th className=\"p-4\">Department / Branch</th>\n                <th className=\"p-4\">Monthly Salary</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {loading ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-500\">Loading directory...</td>\n                </tr>\n              ) : employees.length === 0 ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-500\">No employees found.</td>\n                </tr>\n              ) : (\n                employees.map((emp) => (\n                  <tr key={emp.id} className=\"hover:bg-slate-800/40 transition-colors\">\n                    <td className=\"p-4\">\n                      <div className=\"flex items-center gap-3\">\n                        <img src={emp.avatar_url || \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=250\'} alt=\"\" className=\"w-9 h-9 rounded-xl object-cover ring-1 ring-slate-700\" />\n                        <div>\n                          <p className=\"font-semibold text-white\">{emp.first_name} {emp.last_name}</p>\n                          <p className=\"text-[11px] text-slate-400\">{emp.email}</p>\n                        </div>\n                      </div>\n                    </td>\n                    <td className=\"p-4 font-mono\">\n                      <p className=\"font-bold text-blue-400\">{emp.employee_code}</p>\n                      <p className=\"text-[10px] text-slate-400\">{emp.designation}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <p className=\"font-medium text-slate-200\">{emp.department_name || \'Engineering\'}</p>\n                      <p className=\"text-[10px] text-slate-400\">{emp.branch_name || \'THEIAKSHI HQ\'}</p>\n                    </td>\n                    <td className=\"p-4 font-mono font-semibold text-emerald-400\">\n                      \342\202\271{Number(emp.salary || 0).toLocaleString(\'en-IN\')}\n                    </td>\n                    <td className=\"p-4\">\n                      {emp.is_deleted ? (\n                        <span className=\"bg-rose-500/20 text-rose-400 text-[10px] font-bold px-2 py-0.5 rounded border border-rose-500/30\">DEACTIVATED</span>\n                      ) : (\n                        <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">ACTIVE</span>\n                      )}\n                    </td>\n                    <td className=\"p-4 text-right space-x-2\">\n                      <button onClick={() => setSelectedEmployee(emp)} className=\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg\">\n                        <Eye className=\"w-4 h-4\" />\n                      </button>\n                      {emp.is_deleted ? (\n                        <button onClick={() => handleRestore(emp.id)} className=\"p-1.5 bg-emerald-950 text-emerald-400 hover:bg-emerald-900 rounded-lg\">\n                          <RotateCcw className=\"w-4 h-4\" />\n                        </button>\n                      ) : (\n                        <button onClick={() => handleSoftDelete(emp.id)} className=\"p-1.5 bg-rose-950 text-rose-400 hover:bg-rose-900 rounded-lg\">"
        replacement_content: "      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-xl border border-slate-200 shadow-sm\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <Users className=\"w-6 h-6 text-blue-600\" />\n            Employees Directory\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Manage enterprise headcount, payroll bank accounts, emergency contacts, and status.\n          </p>\n        </div>\n        <button\n          onClick={() => setShowCreateModal(true)}\n          className=\"flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-4 py-2.5 rounded-lg shadow-sm transition-all\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Employee</span>\n        </button>\n      </div>\n\n      {/* Filters & Search */}\n      <div className=\"flex flex-col sm:flex-row items-center gap-3 bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n        <div className=\"relative flex-1 w-full\">\n          <Search className=\"w-4 h-4 absolute left-3 top-3 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by name, code, email or designation...\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            className=\"w-full bg-slate-100 border-none rounded-lg pl-9 pr-3 py-2 text-xs text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 outline-none\"\n          />\n        </div>\n        <select\n          value={roleFilter}\n          onChange={(e) => setRoleFilter(e.target.value)}\n          className=\"bg-slate-100 border-none text-xs text-slate-900 rounded-lg px-3 py-2 w-full sm:w-48 focus:ring-2 focus:ring-blue-500 outline-none font-medium\"\n        >\n          <option value=\"\">All Roles</option>\n          <option value=\"ADMIN\">ADMIN</option>\n          <option value=\"HR_MANAGER\">HR_MANAGER</option>\n          <option value=\"DEPT_HEAD\">DEPT_HEAD</option>\n          <option value=\"EMPLOYEE\">EMPLOYEE</option>\n        </select>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs text-slate-700\">\n            <thead className=\"bg-slate-50 text-slate-500 border-b border-slate-200 uppercase text-[10px] font-black tracking-wider\">\n              <tr>\n                <th className=\"p-4\">Employee</th>\n                <th className=\"p-4\">Code / Role</th>\n                <th className=\"p-4\">Department / Branch</th>\n                <th className=\"p-4\">Monthly Salary</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {loading ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-400\">Loading directory...</td>\n                </tr>\n              ) : employees.length === 0 ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-400\">No employees found.</td>\n                </tr>\n              ) : (\n                employees.map((emp) => (\n                  <tr key={emp.id} className=\"hover:bg-slate-50 transition-colors\">\n                    <td className=\"p-4\">\n                      <div className=\"flex items-center gap-3\">\n                        <img src={emp.avatar_url || \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=250\'} alt=\"\" className=\"w-9 h-9 rounded-full object-cover ring-2 ring-slate-200\" />\n                        <div>\n                          <p className=\"font-bold text-slate-900\">{emp.first_name} {emp.last_name}</p>\n                          <p className=\"text-[11px] text-slate-500\">{emp.email}</p>\n                        </div>\n                      </div>\n                    </td>\n                    <td className=\"p-4 font-mono\">\n                      <p className=\"font-bold text-blue-600\">{emp.employee_code}</p>\n                      <p className=\"text-[10px] text-slate-500\">{emp.designation}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <p className=\"font-semibold text-slate-800\">{emp.department_name || \'Engineering\'}</p>\n                      <p className=\"text-[10px] text-slate-500\">{emp.branch_name || \'THEIAKSHI HQ\'}</p>\n                    </td>\n                    <td className=\"p-4 font-mono font-bold text-emerald-600\">\n                      \342\202\271{Number(emp.salary || 0).toLocaleString(\'en-IN\')}\n                    </td>\n                    <td className=\"p-4\">\n                      {emp.is_deleted ? (\n                        <span className=\"bg-rose-100 text-rose-700 text-[10px] font-bold px-2 py-0.5 rounded border border-rose-200\">DEACTIVATED</span>\n                      ) : (\n                        <span className=\"bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-200\">ACTIVE</span>\n                      )}\n                    </td>\n                    <td className=\"p-4 text-right space-x-2\">\n                      <button onClick={() => setSelectedEmployee(emp)} className=\"p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg\">\n                        <Eye className=\"w-4 h-4\" />\n                      </button>\n                      {emp.is_deleted ? (\n                        <button onClick={() => handleRestore(emp.id)} className=\"p-1.5 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 rounded-lg\">\n                          <RotateCcw className=\"w-4 h-4\" />\n                        </button>\n                      ) : (\n                        <button onClick={() => handleSoftDelete(emp.id)} className=\"p-1.5 bg-rose-100 text-rose-700 hover:bg-rose-200 rounded-lg\">"
      }
      num_matches: 1
    }
  }
}
