      replacement_content: "import dbService from \'../database/db.js\';\nimport { LeaveRequest } from \'../types/index.js\';\n\nexport class LeaveRepository {\n  async getAllLeaves(employeeId?: number, status?: string) {\n    const conditions: string[] = [];\n    const params: any[] = [];\n    let idx = 1;\n\n    if (employeeId) {\n      conditions.push(`l.employee_id = $${idx}`);\n      params.push(employeeId);\n      idx++;\n    }\n\n    if (status) {\n      conditions.push(`l.status = $${idx}`);\n      params.push(status);\n      idx++;\n    }\n\n    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\' AND \')}` : \'\';\n\n    const sql = `\n      SELECT l.*, lt.name as leave_type_name, lt.code as leave_type_code,\n             e.first_name, e.last_name, e.employee_code, e.avatar_url,\n             a.first_name as approver_first_name, a.last_name as approver_last_name\n      FROM leaves l\n      JOIN leave_types lt ON l.leave_type_id = lt.id\n      JOIN employees e ON l.employee_id = e.id\n      LEFT JOIN employees a ON l.approved_by = a.id\n      ${whereClause}\n      ORDER BY l.id DESC\n    `;\n\n    const res = await dbService.query(sql, params);\n    return res.rows;\n  }\n\n  async getLeaveBalances(employeeId: number) {\n    const sql = `\n      SELECT lb.*, lt.name as leave_type_name, lt.code as leave_type_code\n      FROM leave_balances lb\n      JOIN leave_types lt ON lb.leave_type_id = lt.id\n      WHERE lb.employee_id = $1\n    `;\n    const res = await dbService.query(sql, [employeeId]);\n    return res.rows;\n  }\n\n  async getLeaveTypes() {\n    const res = await dbService.query(\'SELECT * FROM leave_types ORDER BY id ASC\');\n    return res.rows;\n  }\n\n  async createLeaveRequest(data: Partial<LeaveRequest>): Promise<LeaveRequest> {\n    const res = await dbService.query<LeaveRequest>(\n      `INSERT INTO leaves (employee_id, leave_type_id, start_date, end_date, total_days, reason, status)\n       VALUES ($1, $2, $3, $4, $5, $6, \'PENDING\')\n       RETURNING *`,\n      [data.employee_id, data.leave_type_id, data.start_date, data.end_date, data.total_days, data.reason]\n    );\n    return res.rows[0];\n  }\n\n  async updateLeaveStatus(id: number, status: \'APPROVED\' | \'REJECTED\', approvedBy: number, rejectionReason?: string) {\n    const res = await dbService.query<LeaveRequest>(\n      `UPDATE leaves\n       SET status = $1, approved_by = $2, rejection_reason = $3\n       WHERE id = $4\n       RETURNING *`,\n      [status, approvedBy, rejectionReason || null, id]\n    );\n\n    if (status === \'APPROVED\' && res.rows[0]) {\n      const leave = res.rows[0];\n      await dbService.query(\n        `UPDATE leave_balances\n         SET used = used + $1, remaining = remaining - $1\n         WHERE employee_id = $2 AND leave_type_id = $3`,\n        [leave.total_days, leave.employee_id, leave.leave_type_id]\n      );\n    }\n\n    return res.rows[0] || null;\n  }\n}\n\nexport const leaveRepository = new LeaveRepository();\n"
    }
