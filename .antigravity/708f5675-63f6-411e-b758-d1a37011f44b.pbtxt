      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Receipt className=\"w-6 h-6 text-rose-400\" />\n            Expense Reimbursement Claims\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Submit travel, meal, hardware & operational expense receipts.</p>\n        </div>\n        <button onClick={() => setShowSubmitModal(true)} className=\"bg-rose-600 hover:bg-rose-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center gap-2 shadow-lg\">\n          <Plus className=\"w-4 h-4\" />\n          <span>New Claim</span>\n        </button>\n      </div>\n\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <table className=\"w-full text-left text-xs text-slate-300\">\n          <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px]\">\n            <tr>\n              <th className=\"p-4\">Employee</th>\n              <th className=\"p-4\">Title / Category</th>\n              <th className=\"p-4\">Amount</th>\n              <th className=\"p-4\">Date</th>\n              <th className=\"p-4\">Status</th>\n              <th className=\"p-4 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {expenses.map((exp) => (\n              <tr key={exp.id} className=\"hover:bg-slate-800/40\">\n                <td className=\"p-4 font-semibold text-white\">{exp.first_name} {exp.last_name}</td>\n                <td className=\"p-4\">\n                  <p className=\"font-bold text-slate-200\">{exp.title}</p>\n                  <p className=\"text-[10px] text-slate-400 font-mono\">{exp.category}</p>\n                </td>\n                <td className=\"p-4 font-mono font-bold text-emerald-400\">\342\202\271{Number(exp.amount).toLocaleString(\'en-IN\')}</td>\n                <td className=\"p-4 font-mono\">{exp.date}</td>\n                <td className=\"p-4\">\n                  <span className={`text-[10px] font-bold px-2 py-0.5 rounded border ${\n                    exp.status === \'APPROVED\' ? \'bg-emerald-500/20 text-emerald-400 border-emerald-500/30\' : exp.status === \'REJECTED\' ? \'bg-rose-500/20 text-rose-400 border-rose-500/30\' : \'bg-amber-500/20 text-amber-300 border-amber-500/30\'\n                  }`}>\n                    {exp.status}\n                  </span>\n                </td>\n                <td className=\"p-4 text-right space-x-1\">\n                  {exp.status === \'PENDING\' && (\n                    <>\n                      <button onClick={() => handleApprove(exp.id, \'APPROVED\')} className=\"p-1.5 bg-emerald-950 text-emerald-400 hover:bg-emerald-900 rounded-lg\"><Check className=\"w-4 h-4\" /></button>\n                      <button onClick={() => handleApprove(exp.id, \'REJECTED\')} className=\"p-1.5 bg-rose-950 text-rose-400 hover:bg-rose-900 rounded-lg\"><X className=\"w-4 h-4\" /></button>\n                    </>\n                  )}\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n\n      {showSubmitModal && (\n        <div className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md space-y-4\">\n            <h3 className=\"text-base font-bold text-white\">Submit Expense Reimbursement</h3>\n            <form onSubmit={handleSubmit} className=\"space-y-3 text-xs\">\n              <div>\n                <label className=\"text-slate-400\">Claim Title</label>\n                <input required type=\"text\" value={formData.title} onChange={(e) => setFormData({ ...formData, title: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-slate-400\">Category</label>\n                  <input required type=\"text\" value={formData.category} onChange={(e) => setFormData({ ...formData, category: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n                <div>\n                  <label className=\"text-slate-400\">Amount (\342\202\271)</label>\n                  <input required type=\"number\" value={formData.amount} onChange={(e) => setFormData({ ...formData, amount: Number(e.target.value) })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n              </div>\n              <div>\n                <label className=\"text-slate-400\">Description</label>\n                <textarea rows={3} value={formData.description} onChange={(e) => setFormData({ ...formData, description: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n              </div>\n              <div className=\"flex justify-end gap-2 pt-2\">\n                <button type=\"button\" onClick={() => setShowSubmitModal(false)} className=\"px-4 py-2 bg-slate-800 text-slate-300 rounded-lg\">Cancel</button>\n                <button type=\"submit\" className=\"px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-lg\">Submit Claim</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
        replacement_content: "  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <Receipt className=\"w-6 h-6 text-rose-600\" />\n            Expense Reimbursement Claims\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-1\">Submit travel, meal, hardware & operational expense receipts.</p>\n        </div>\n        <button onClick={() => setShowSubmitModal(true)} className=\"bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm transition-all\">\n          <Plus className=\"w-4 h-4\" />\n          <span>New Claim</span>\n        </button>\n      </div>\n\n      <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm\">\n        <table className=\"w-full text-left text-xs text-slate-700\">\n          <thead className=\"bg-slate-50 text-slate-500 border-b border-slate-200 uppercase text-[10px] font-black tracking-wider\">\n            <tr>\n              <th className=\"p-4\">Employee</th>\n              <th className=\"p-4\">Title / Category</th>\n              <th className=\"p-4\">Amount</th>\n              <th className=\"p-4\">Date</th>\n              <th className=\"p-4\">Status</th>\n              <th className=\"p-4 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {expenses.map((exp) => (\n              <tr key={exp.id} className=\"hover:bg-slate-50\">\n                <td className=\"p-4 font-bold text-slate-900\">{exp.first_name} {exp.last_name}</td>\n                <td className=\"p-4\">\n                  <p className=\"font-bold text-slate-900\">{exp.title}</p>\n                  <p className=\"text-[10px] text-slate-500 font-mono font-medium\">{exp.category}</p>\n                </td>\n                <td className=\"p-4 font-mono font-bold text-emerald-600\">\342\202\271{Number(exp.amount).toLocaleString(\'en-IN\')}</td>\n                <td className=\"p-4 font-mono font-medium\">{exp.date}</td>\n                <td className=\"p-4\">\n                  <span className={`text-[10px] font-bold px-2 py-0.5 rounded ${\n                    exp.status === \'APPROVED\' ? \'bg-emerald-100 text-emerald-800 border border-emerald-200\' : exp.status === \'REJECTED\' ? \'bg-rose-100 text-rose-700 border border-rose-200\' : \'bg-orange-100 text-orange-700 border border-orange-200\'\n                  }`}>\n                    {exp.status}\n                  </span>\n                </td>\n                <td className=\"p-4 text-right space-x-1\">\n                  {exp.status === \'PENDING\' && (\n                    <>\n                      <button onClick={() => handleApprove(exp.id, \'APPROVED\')} className=\"p-1.5 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 rounded-lg transition-colors\"><Check className=\"w-4 h-4\" /></button>\n                      <button onClick={() => handleApprove(exp.id, \'REJECTED\')} className=\"p-1.5 bg-rose-100 text-rose-700 hover:bg-rose-200 rounded-lg transition-colors\"><X className=\"w-4 h-4\" /></button>\n                    </>\n                  )}\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n\n      {showSubmitModal && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white border border-slate-200 rounded-xl p-6 w-full max-w-md space-y-4 shadow-2xl text-slate-900\">\n            <h3 className=\"text-base font-bold text-slate-900\">Submit Expense Reimbursement</h3>\n            <form onSubmit={handleSubmit} className=\"space-y-3 text-xs\">\n              <div>\n                <label className=\"text-slate-600 font-semibold\">Claim Title</label>\n                <input required type=\"text\" value={formData.title} onChange={(e) => setFormData({ ...formData, title: e.target.value })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-slate-600 font-semibold\">Category</label>\n                  <input required type=\"text\" value={formData.category} onChange={(e) => setFormData({ ...formData, category: e.target.value })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n                </div>\n                <div>\n                  <label className=\"text-slate-600 font-semibold\">Amount (\342\202\271)</label>\n                  <input required type=\"number\" value={formData.amount} onChange={(e) => setFormData({ ...formData, amount: Number(e.target.value) })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n                </div>\n              </div>\n              <div>\n                <label className=\"text-slate-600 font-semibold\">Description</label>\n                <textarea rows={3} value={formData.description} onChange={(e) => setFormData({ ...formData, description: e.target.value })} className=\"w-full bg-slate-100 border border-slate-200 rounded-lg p-2 text-slate-900 mt-1 font-medium\" />\n              </div>\n              <div className=\"flex justify-end gap-2 pt-2\">\n                <button type=\"button\" onClick={() => setShowSubmitModal(false)} className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg\">Cancel</button>\n                <button type=\"submit\" className=\"px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-lg shadow-sm\">Submit Claim</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
      }
      num_matches: 1
    }
  }
}
