      target_content: "export const OrgChartPage: React.FC = () => {\n  const [employees, setEmployees] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchOrg = async () => {\n      try {\n        const res = await apiClient.get(\'/employees?limit=50\');\n        if (res.data?.success) setEmployees(res.data.data.employees);\n      } catch (e) { console.error(e); }\n    };\n    fetchOrg();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800\">\n        <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n          <Network className=\"w-6 h-6 text-blue-400\" />\n          Organization Hierarchy\n        </h2>\n        <p className=\"text-xs text-slate-400 mt-1\">Interactive reporting lines across THEIAKSHI ENTERPRISES departments.</p>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        {employees.map((emp) => (\n          <div key={emp.id} className=\"bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center gap-3\">\n            <img src={emp.avatar_url} alt=\"\" className=\"w-12 h-12 rounded-xl object-cover ring-2 ring-blue-500/30\" />\n            <div>\n              <p className=\"font-bold text-white text-sm\">{emp.first_name} {emp.last_name}</p>\n              <p className=\"text-xs text-blue-400 font-mono\">{emp.designation}</p>\n              <p className=\"text-[10px] text-slate-400\">{emp.department_name}</p>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport const PerformancePage: React.FC = () => {\n  const [reviews, setReviews] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchReviews = async () => {\n      try {\n        const res = await apiClient.get(\'/performance\');\n        if (res.data?.success) setReviews(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchReviews();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800\">\n        <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n          <Award className=\"w-6 h-6 text-amber-400\" />\n          Performance Appraisals & Reviews\n        </h2>\n        <p className=\"text-xs text-slate-400 mt-1\">Quarterly appraisal ratings, manager feedback & goal milestones.</p>\n      </div>\n\n      <div className=\"space-y-4\">\n        {reviews.map((r) => (\n          <div key={r.id} className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3\">\n            <div className=\"flex justify-between items-center\">\n              <div>\n                <h3 className=\"font-bold text-white text-base\">{r.first_name} {r.last_name}</h3>\n                <p className=\"text-xs text-slate-400\">{r.designation} \342\200\242 Review Period: <strong className=\"text-blue-400 font-mono\">{r.review_period}</strong></p>\n              </div>\n              <div className=\"flex items-center gap-1 bg-amber-500/20 text-amber-300 px-3 py-1 rounded-xl border border-amber-500/30 text-sm font-bold font-mono\">\n                <Star className=\"w-4 h-4 fill-amber-300\" />\n                <span>{r.rating} / 5.0</span>\n              </div>\n            </div>\n            <p className=\"text-xs text-slate-300 bg-slate-950 p-3 rounded-xl border border-slate-800\">{r.feedback}</p>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};"
