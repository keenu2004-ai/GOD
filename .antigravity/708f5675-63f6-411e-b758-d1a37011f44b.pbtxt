      replacement_content: "import { attendanceRepository } from \'../repositories/attendanceRepository.js\';\nimport { branchRepository } from \'../repositories/miscRepository.js\';\n\nexport class AttendanceService {\n  // Geofence calculation (Haversine formula in km)\n  private calculateDistanceMeters(lat1: number, lon1: number, lat2: number, lon2: number): number {\n    const R = 6371e3; // Earth radius in meters\n    const phi1 = (lat1 * Math.PI) / 180;\n    const phi2 = (lat2 * Math.PI) / 180;\n    const deltaPhi = ((lat2 - lat1) * Math.PI) / 180;\n    const deltaLambda = ((lon2 - lon1) * Math.PI) / 180;\n\n    const a =\n      Math.sin(deltaPhi / 2) * Math.sin(deltaPhi / 2) +\n      Math.cos(phi1) * Math.cos(phi2) * Math.sin(deltaLambda / 2) * Math.sin(deltaLambda / 2);\n\n    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n    return R * c;\n  }\n\n  async punchIn(employeeId: number, lat: number, lng: number, branchId: number = 1) {\n    const todayStr = new Date().toISOString().split(\'T\')[0];\n    const existing = await attendanceRepository.getTodayStatus(employeeId, todayStr);\n    if (existing && existing.punch_in) {\n      throw new Error(\'Already punched in for today!\');\n    }\n\n    // Check Geofence\n    const branches = await branchRepository.getAll();\n    const branch = branches.find((b: any) => b.id === branchId) || branches[0];\n    if (branch && branch.latitude && branch.longitude) {\n      const distance = this.calculateDistanceMeters(lat, lng, Number(branch.latitude), Number(branch.longitude));\n      console.log(`[Geofence GPS] Employee ${employeeId} distance from branch ${branch.name}: ${Math.round(distance)} meters`);\n    }\n\n    const now = new Date();\n    const isLate = now.getHours() > 9 || (now.getHours() === 9 && now.getMinutes() > 15);\n\n    return await attendanceRepository.punchIn(\n      employeeId,\n      todayStr,\n      lat,\n      lng,\n      isLate,\n      \'General Shift (9 AM - 6 PM)\'\n    );\n  }\n\n  async punchOut(employeeId: number, lat: number, lng: number) {\n    const todayStr = new Date().toISOString().split(\'T\')[0];\n    const existing = await attendanceRepository.getTodayStatus(employeeId, todayStr);\n    if (!existing || !existing.punch_in) {\n      throw new Error(\'Must punch in before punching out!\');\n    }\n    if (existing.punch_out) {\n      throw new Error(\'Already punched out for today!\');\n    }\n\n    const punchInTime = new Date(existing.punch_in).getTime();\n    const nowTime = new Date().getTime();\n    const workHours = Math.max(0.5, parseFloat(((nowTime - punchInTime) / (1000 * 60 * 60)).toFixed(2)));\n    const isOvertime = workHours > 9;\n\n    return await attendanceRepository.punchOut(existing.id, lat, lng, workHours, isOvertime);\n  }\n\n  async getMyStatus(employeeId: number) {\n    const todayStr = new Date().toISOString().split(\'T\')[0];\n    return await attendanceRepository.getTodayStatus(employeeId, todayStr);\n  }\n\n  async getHistory(employeeId: number) {\n    return await attendanceRepository.getEmployeeHistory(employeeId);\n  }\n\n  async getTodayAllAttendance() {\n    return await attendanceRepository.getTodayAllAttendance();\n  }\n}\n\nexport const attendanceService = new AttendanceService();\n"
    }
