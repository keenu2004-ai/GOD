 rounded-lg shadow-sm transition-all\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5 text-amber-300 animate-bounce\" />\n          <span>AI Insights</span>\n        </button>\n\n        {/* Notifications Bell */}\n        <div className=\"relative\">\n          <button\n            onClick={() => setShowNotifications(!showNotifications)}\n            className=\"relative p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors\"\n          >\n            <Bell className=\"w-5 h-5\" />\n            {unreadCount > 0 && (\n              <span className=\"absolute top-1 right-1 bg-rose-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center\">\n                {unreadCount}\n              </span>\n            )}\n          </button>\n\n          {/* Notifications Dropdown */}\n          {showNotifications && (\n            <div className=\"absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl p-3 z-50\">\n              <div className=\"flex items-center justify-between pb-2 border-b border-slate-800\">\n                <span className=\"text-xs font-bold text-white uppercase tracking-wider\">Enterprise Notifications</span>\n                <span className=\"text-[10px] text-blue-400\">{unreadCount} unread</span>\n              </div>\n              <div className=\"max-h-64 overflow-y-auto mt-2 space-y-2\">\n                {notifications.length === 0 ? (\n                  <p className=\"text-xs text-slate-500 text-center py-4\">No notifications</p>\n                ) : (\n                  notifications.map((n) => (\n                    <div key={n.id} className=\"p-2.5 rounded-lg bg-slate-950/80 border border-slate-800/80 text-xs\">\n                      <div className=\"flex items-center justify-between text-slate-200 font-medium\">\n                        <span>{n.title}</span>\n                        <span className=\"text-[10px] text-slate-500\">Just now</span>\n                      </div>\n                      <p className=\"text-slate-400 text-[11px] mt-1\">{n.message}</p>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* User Profile */}\n        <div className=\"relative\">\n          <button\n            onClick={() => setShowProfileMenu(!showProfileMenu)}\n            className=\"flex items-center gap-2 p-1.5 hover:bg-slate-800 rounded-lg transition-colors text-left\"\n          >\n            <img\n              src={user?.avatar_url || \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=250\'}\n              alt=\"Avatar\"\n              className=\"w-8 h-8 rounded-lg object-cover ring-2 ring-blue-500/40\"\n            />\n            <div className=\"hidden sm:block\">\n              <p className=\"text-xs font-semibold text-white leading-tight\">\n                {user?.first_name} {user?.last_name}\n              </p>\n              <p className=\"text-[10px] text-blue-400 font-mono\">{user?.role || \'ADMIN\'}</p>\n            </div>\n            <ChevronDown className=\"w-3.5 h-3.5 text-slate-400 hidden sm:block\" />\n          </button>\n\n          {showProfileMenu && (\n            <div className=\"absolute right-0 mt-2 w-56 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl p-2 z-50 text-xs\">\n              <div className=\"px-3 py-2 border-b border-slate-800\">\n                <p className=\"font-semibold text-white\">{user?.first_name} {user?.last_name}</p>\n                <p className=\"text-[10px] text-slate-400 font-mono mt-0.5\">{user?.email}</p>\n                <div className=\"flex items-center gap-1 mt-1 text-[10px] text-emerald-400\">\n                  <ShieldCheck className=\"w-3 h-3\" />\n                  <span>Authenticated JWT</span>\n                </div>\n              </div>\n              <button\n                onClick={log