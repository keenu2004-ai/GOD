    absolute_path_uri: "file:///src/backend/services/leaveService.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { leaveRepository } from \'../repositories/leaveRepository.js\';\nimport { payrollRepository } from \'../repositories/payrollRepository.js\';\n\nexport class LeaveService {\n  async getAllLeaves(employeeId?: number, status?: string) {\n    return await leaveRepository.getAllLeaves(employeeId, status);\n  }\n\n  async getLeaveBalances(employeeId: number) {\n    return await leaveRepository.getLeaveBalances(employeeId);\n  }\n\n  async getLeaveTypes() {\n    return await leaveRepository.getLeaveTypes();\n  }\n\n  async applyLeave(data: any) {\n    const startDate = new Date(data.start_date);\n    const endDate = new Date(data.end_date);\n    const diffTime = Math.abs(endDate.getTime() - startDate.getTime());\n    const totalDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;\n\n    return await leaveRepository.createLeaveRequest({\n      ...data,\n      total_days: totalDays,\n    });\n  }\n\n  async processLeaveApproval(id: number, status: \'APPROVED\' | \'REJECTED\', approvedBy: number, rejectionReason?: string) {\n    return await leaveRepository.updateLeaveStatus(id, status, approvedBy, rejectionReason);\n  }\n}\n\nexport class PayrollService {\n  async getAllPayrolls(month?: string, year?: number, employeeId?: number) {\n    return await payrollRepository.getAllPayrolls(month, year, employeeId);\n  }\n\n  async getPayslipDetails(id: number) {\n    const payslip = await payrollRepository.getById(id);\n    if (!payslip) throw new Error(\'Payslip not found\');\n    return payslip;\n  }\n\n  async generatePayroll(employeeId: number, month: string, year: number, basicSalary: number) {\n    return await payrollRepository.generatePayrollForEmployee(employeeId, month, year, basicSalary);\n  }\n}\n\nexport const leaveService = new LeaveService();\nexport const payrollService = new PayrollService();\n"
