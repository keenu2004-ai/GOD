    replacement_chunks {
      replacement_content: "import dbService from \'../database/db.js\';\nimport { AttendanceRecord } from \'../types/index.js\';\n\nexport class AttendanceRepository {\n  async getTodayStatus(employeeId: number, dateStr: string): Promise<AttendanceRecord | null> {\n    const res = await dbService.query<AttendanceRecord>(\n      \'SELECT * FROM attendance WHERE employee_id = $1 AND date = $2 LIMIT 1\',\n      [employeeId, dateStr]\n    );\n    return res.rows[0] || null;\n  }\n\n  async punchIn(employeeId: number, dateStr: string, lat: number, lng: number, isLate: boolean, shiftName: string): Promise<AttendanceRecord> {\n    const nowTimestamp = new Date().toISOString().replace(\'T\', \' \').substring(0, 19);\n    const res = await dbService.query<AttendanceRecord>(\n      `INSERT INTO attendance (employee_id, date, punch_in, punch_in_lat, punch_in_lng, status, is_late, shift_name)\n       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)\n       RETURNING *`,\n      [employeeId, dateStr, nowTimestamp, lat, lng, isLate ? \'LATE\' : \'PRESENT\', isLate, shiftName]\n    );\n    return res.rows[0];\n  }\n\n  async punchOut(id: number, lat: number, lng: number, workHours: number, isOvertime: boolean): Promise<AttendanceRecord> {\n    const nowTimestamp = new Date().toISOString().replace(\'T\', \' \').substring(0, 19);\n    const res = await dbService.query<AttendanceRecord>(\n      `UPDATE attendance\n       SET punch_out = $1, punch_out_lat = $2, punch_out_lng = $3, work_hours = $4, is_overtime = $5\n       WHERE id = $6\n       RETURNING *`,\n      [nowTimestamp, lat, lng, workHours, isOvertime, id]\n    );\n    return res.rows[0];\n  }\n\n  async getEmployeeHistory(employeeId: number, month?: string, year?: number) {\n    let sql = `SELECT * FROM attendance WHERE employee_id = $1 ORDER BY date DESC`;\n    const res = await dbService.query<AttendanceRecord>(sql, [employeeId]);\n    return res.rows;\n  }\n\n  async getTodayAllAttendance() {\n    const today = new Date().toISOString().split(\'T\')[0];\n    const sql = `\n      SELECT a.*, e.first_name, e.last_name, e.employee_code, e.avatar_url, d.name as department_name\n      FROM attendance a\n      JOIN employees e ON a.employee_id = e.id\n      LEFT JOIN departments d ON e.department_id = d.id\n      WHERE a.date = $1\n      ORDER BY a.punch_in ASC\n    `;\n    const res = await dbService.query(sql, [today]);\n    return res.rows;\n  }\n}\n\nexport const attendanceRepository = new AttendanceRepository();\n"
    }
