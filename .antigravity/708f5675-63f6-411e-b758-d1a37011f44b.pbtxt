  file_change {
    absolute_path_uri: "file:///src/backend/database_v2/connection.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { PGlite } from \'@electric-sql/pglite\';\n\nexport interface QueryResult<T = any> {\n  rows: T[];\n  rowCount: number;\n}\n\nexport interface DatabaseConfig {\n  maxConnections?: number;\n  idleTimeoutMillis?: number;\n  connectionTimeoutMillis?: number;\n  ssl?: boolean;\n}\n\nclass DatabaseConnectionManager {\n  private pgliteDb: PGlite | null = null;\n  private isInitialized = false;\n  private config: DatabaseConfig = {\n    maxConnections: 100,\n    idleTimeoutMillis: 30000,\n    connectionTimeoutMillis: 5000,\n  };\n\n  async getInstance(): Promise<PGlite> {\n    if (!this.pgliteDb) {\n      this.pgliteDb = new PGlite();\n    }\n    if (!this.isInitialized) {\n      await this.initSchemaAndSeed();\n    }\n    return this.pgliteDb;\n  }\n\n  private async initSchemaAndSeed() {\n    if (!this.pgliteDb) return;\n    this.isInitialized = true;\n    console.log(\'[DatabaseV2 Engine] Bootstrapping PostgreSQL enterprise architecture...\');\n    \n    // Lazy load schema & seed to maintain clean modularity\n    const { initializeEnterpriseSchema } = await import(\'./schema.js\');\n    await initializeEnterpriseSchema(this.pgliteDb);\n\n    const { initializeIndexes } = await import(\'./indexes.js\');\n    await initializeIndexes(this.pgliteDb);\n\n    const { initializeConstraints } = await import(\'./constraints.js\');\n    await initializeConstraints(this.pgliteDb);\n\n    const { initializeTriggersAndFunctions } = await import(\'./triggers.js\');\n    await initializeTriggersAndFunctions(this.pgliteDb);\n\n    const { initializeViews } = await import(\'./views.js\');\n    await initializeViews(this.pgliteDb);\n\n    const { seedEnterpriseDatabase } = await import(\'./seed.js\');\n    await seedEnterpriseDatabase(this.pgliteDb);\n\n    console.log(\'[DatabaseV2 Engine] PostgreSQL enterprise architecture operational.\');\n  }\n\n  async query<T = any>(sql: string, params: any[] = []): Promise<QueryResult<T>> {\n    const startTime = Date.now();\n    const instance = await this.getInstance();\n    \n    try {\n      const result = await instance.query(sql, params);\n      const executionTimeMs = Date.now() - startTime;\n\n      if (executionTimeMs > 200) {\n        console.warn(`[DatabaseV2 Slow Query] (${executionTimeMs}ms): ${sql.substring(0, 100)}...`);\n      }\n\n      return {\n        rows: (result.rows as T[]) || [],\n        rowCount: result.rows ? result.rows.length : 0,\n      };\n    } catch (error: any) {\n      console.error(`[DatabaseV2 Query Error]: ${error.message} | Query: ${sql}`);\n      throw error;\n    }\n  }\n\n  async exec(sql: string): Promise<void> {\n    const instance = await this.getInstance();\n    await instance.exec(sql);\n  }\n\n  async transaction<T>(callback: (client: DatabaseConnectionManager) => Promise<T>): Promise<T> {\n    await this.exec(\'BEGIN\');\n    try {\n      const result = await callback(this);\n      await this.exec(\'COMMIT\');\n      return result;\n    } catch (error) {\n      await this.exec(\'ROLLBACK\');\n      throw error;\n    }\n  }\n\n  async healthCheck(): Promise<{ status: string; latencyMs: number; poolInfo: DatabaseConfig }> {\n    const startTime = Date.now();\n    const result = await this.query(\'SELECT 1 as healthy, NOW() as current_time\');\n    const latencyMs = Date.now() - startTime;\n\n    return {\n      status: result.rows.length > 0 ? \'HEALTHY\' : \'UNHEALTHY\',\n      latencyMs,\n      poolInfo: this.config,\n    };\n  }\n}\n\nexport const dbConnectionV2 = new DatabaseConnectionManager();\nexport default dbConnectionV2;\n"
    }
