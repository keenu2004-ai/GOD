    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Users,\n  Search,\n  Plus,\n  Trash2,\n  RotateCcw,\n  Eye,\n  Edit2,\n  Building2,\n  Briefcase,\n  Mail,\n  Phone,\n  DollarSign,\n  CreditCard,\n  X,\n  CheckCircle,\n} from \'lucide-react\';\nimport apiClient from \'../services/apiClient.js\';\nimport { UserProfile } from \'../types/index.js\';\n\nexport const EmployeesPage: React.FC = () => {\n  const [employees, setEmployees] = useState<UserProfile[]>([]);\n  const [total, setTotal] = useState<number>(0);\n  const [page, setPage] = useState<number>(1);\n  const [search, setSearch] = useState<string>(\'\');\n  const [roleFilter, setRoleFilter] = useState<string>(\'\');\n  const [loading, setLoading] = useState<boolean>(true);\n  const [selectedEmployee, setSelectedEmployee] = useState<UserProfile | null>(null);\n  const [showCreateModal, setShowCreateModal] = useState<boolean>(false);\n\n  // Form state\n  const [formData, setFormData] = useState({\n    first_name: \'\',\n    last_name: \'\',\n    email: \'\',\n    phone: \'\',\n    role: \'EMPLOYEE\',\n    designation: \'Software Engineer\',\n    department_id: 2,\n    branch_id: 1,\n    salary: 80000,\n    bank_account: \'918237192890\',\n    ifsc_code: \'HDFC0001234\',\n    pan_number: \'ABCDE1234F\',\n    emergency_contact_name: \'Contact Person\',\n    emergency_contact_phone: \'+91 9876543210\',\n  });\n\n  const fetchEmployees = async () => {\n    try {\n      setLoading(true);\n      const res = await apiClient.get(\'/employees\', {\n        params: {\n          page,\n          limit: 10,\n          search,\n          role: roleFilter || undefined,\n          includeDeleted: true,\n        },\n      });\n      if (res.data?.success) {\n        setEmployees(res.data.data.employees);\n        setTotal(res.data.data.total);\n      }\n    } catch (err) {\n      console.error(\'Failed to fetch employees:\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchEmployees();\n  }, [page, search, roleFilter]);\n\n  const handleCreate = async (e: React.FormEvent) => {\n    e.preventDefault();\n    try {\n      const code = `THK${Math.floor(100 + Math.random() * 900)}`;\n      await apiClient.post(\'/employees\', {\n        ...formData,\n        employee_code: code,\n      });\n      setShowCreateModal(false);\n      fetchEmployees();\n    } catch (err: any) {\n      alert(err.response?.data?.message || \'Failed to create employee\');\n    }\n  };\n\n  const handleSoftDelete = async (id: number) => {\n    if (!confirm(\'Are you sure you want to deactivate/soft-delete this employee?\')) return;\n    try {\n      await apiClient.delete(`/employees/${id}`);\n      fetchEmployees();\n    } catch (err) {\n      alert(\'Failed to delete employee\');\n    }\n  };\n\n  const handleRestore = async (id: number) => {\n    try {\n      await apiClient.post(`/employees/${id}/restore`);\n      fetchEmployees();\n    } catch (err) {\n      alert(\'Failed to restore employee\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 p-5 rounded-2xl border border-slate-800\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Users className=\"w-6 h-6 text-blue-500\" />\n            Employees Directory\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Manage enterprise headcount, payroll bank accounts, emergency contacts, and status.\n          </p>\n        </div>\n        <button\n          onClick={() => setShowCreateModal(true)}\n          className=\"flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-lg transition-all\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Employee</span>\n        </button>\n      </div>\n\n      {/* Filters & Search */}\n      <div className=\"flex flex-col sm:flex-row items-center gap-3 bg-slate-900/60 p-4 rounded-xl border border-slate-800\">\n        <div className=\"relative flex-1 w-full\">\n          <Search className=\"w-4 h-4 absolute left-3 top-3 text-slate-500\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by name, code, email or designation...\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            className=\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500\"\n          />\n        </div>\n        <select\n          value={roleFilter}\n          onChange={(e) => setRoleFilter(e.target.value)}\n          className=\"bg-slate-950 border border-slate-800 text-xs text-white rounded-lg px-3 py-2 w-full sm:w-48 focus:outline-none focus:border-blue-500\"\n        >\n          <option value=\"\">All Roles</option>\n          <option value=\"ADMIN\">ADMIN</option>\n          <option value=\"HR_MANAGER\">HR_MANAGER</option>\n          <option value=\"DEPT_HEAD\">DEPT_HEAD</option>\n          <option value=\"EMPLOYEE\">EMPLOYEE</option>\n        </select>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs text-slate-300\">\n            <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-800\">\n              <tr>\n                <th className=\"p-4\">Employee</th>\n                <th className=\"p-4\">Code / Role</th>\n                <th className=\"p-4\">Department / Branch</th>\n                <th className=\"p-4\">Monthly Salary</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {loading ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-500\">Loading directory...</td>\n                </tr>\n              ) : employees.length === 0 ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-500\">No employees found.</td>\n                </tr>\n              ) : (\n                employees.map((emp) => (\n                  <tr key={emp.id} className=\"hover:bg-slate-800/40 transition-colors\">\n                    <td className=\"p-4\">\n                      <div className=\"flex items-center gap-3\">\n                        <img src={emp.avatar_url || \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=250\'} alt=\"\" className=\"w-9 h-9 rounded-xl object-cover ring-1 ring-slate-700\" />\n                        <div>\n                          <p className=\"font-semibold text-white\">{emp.first_name} {emp.last_name}</p>\n                          <p className=\"text-[11px] text-slate-400\">{emp.email}</p>\n                        </div>\n                      </div>\n                    </td>\n                    <td className=\"p-4 font-mono\">\n                      <p className=\"font-bold text-blue-400\">{emp.employee_code}</p>\n                      <p className=\"text-[10px] text-slate-400\">{emp.designation}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <p className=\"font-medium text-slate-200\">{emp.department_name || \'Engineering\'}</p>\n                      <p className=\"text-[10px] text-slate-400\">{emp.branch_name || \'THEIAKSHI HQ\'}</p>\n                    </td>\n                    <td className=\"p-4 font-mono font-semibold text-emerald-400\">\n                      \342\202\271{Number(emp.salary || 0).toLocaleString(\'en-IN\')}\n                    </td>\n                    <td className=\"p-4\">\n                      {emp.is_deleted ? (\n                        <span className=\"bg-rose-500/20 text-rose-400 text-[10px] font-bold px-2 py-0.5 rounded border border-rose-500/30\">DEACTIVATED</span>\n                      ) : (\n                        <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">ACTIVE</span>\n                      )}\n                    </td>\n                    <td className=\"p-4 text-right space-x-2\">\n                      <button onClick={() => setSelectedEmployee(emp)} className=\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg\">\n                        <Eye className=\"w-4 h-4\" />\n                      </button>\n                      {emp.is_deleted ? (\n                        <button onClick={() => handleRestore(emp.id)} className=\"p-1.5 bg-emerald-950 text-emerald-400 hover:bg-emerald-900 rounded-lg\">\n                          <RotateCcw className=\"w-4 h-4\" />\n                        </button>\n                      ) : (\n                        <button onClick={() => handleSoftDelete(emp.id)} className=\"p-1.5 bg-rose-950 text-rose-400 hover:bg-rose-900 rounded-lg\">\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                ))\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Profile Drawer */}\n      {selectedEmployee && (\n        <div className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex justify-end\">\n          <div className=\"w-full max-w-md bg-slate-900 border-l border-slate-800 p-6 overflow-y-auto space-y-6\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n              <h3 className=\"font-bold text-white text-base\">Employee Profile</h3>\n              <button onClick={() => setSelectedEmployee(null)} className=\"p-1 text-slate-400 hover:text-white\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n            <div className=\"text-center\">\n              <img src={selectedEmployee.avatar_url} alt=\"\" className=\"w-20 h-20 rounded-2xl mx-auto object-cover ring-2 ring-blue-500/50\" />\n              <h4 className=\"font-bold text-white text-lg mt-3\">{selectedEmployee.first_name} {selectedEmployee.last_name}</h4>\n              <p className=\"text-xs text-blue-400 font-mono font-semibold\">{selectedEmployee.employee_code} \342\200\242 {selectedEmployee.designation}</p>\n            </div>\n            <div className=\"space-y-3 text-xs bg-slate-950 p-4 rounded-xl border border-slate-800\">\n              <div className=\"flex justify-between py-1 border-b border-slate-800/60\">\n                <span className=\"text-slate-400\">Email:</span>\n                <span className=\"font-medium text-white\">{selectedEmployee.email}</span>\n              </div>\n              <div className=\"flex justify-between py-1 border-b border-slate-800/60\">\n                <span className=\"text-slate-400\">Phone:</span>\n                <span className=\"font-medium text-white\">{selectedEmployee.phone}</span>\n              </div>\n              <div className=\"flex justify-between py-1 border-b border-slate-800/60\">\n                <span className=\"text-slate-400\">Department:</span>\n                <span className=\"font-medium text-white\">{selectedEmployee.department_name}</span>\n              </div>\n              <div className=\"flex justify-between py-1 border-b border-slate-800/60\">\n                <span className=\"text-slate-400\">Bank Account:</span>\n                <span className=\"font-medium text-emerald-400 font-mono\">{selectedEmployee.bank_account || \'N/A\'}</span>\n              </div>\n              <div className=\"flex justify-between py-1\">\n                <span className=\"text-slate-400\">IFSC Code:</span>\n                <span className=\"font-medium text-white font-mono\">{selectedEmployee.ifsc_code || \'N/A\'}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Create Modal */}\n      {showCreateModal && (\n        <div className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-lg space-y-4\">\n            <div className=\"flex justify-between items-center border-b border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-white\">Add New Enterprise Employee</h3>\n              <button onClick={() => setShowCreateModal(false)} className=\"text-slate-400 hover:text-white\"><X className=\"w-5 h-5\" /></button>\n            </div>\n            <form onSubmit={handleCreate} className=\"space-y-3 text-xs\">\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-slate-400\">First Name</label>\n                  <input required type=\"text\" value={formData.first_name} onChange={(e) => setFormData({ ...formData, first_name: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n                <div>\n                  <label className=\"text-slate-400\">Last Name</label>\n                  <input required type=\"text\" value={formData.last_name} onChange={(e) => setFormData({ ...formData, last_name: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n              </div>\n              <div>\n                <label className=\"text-slate-400\">Corporate Email</label>\n                <input required type=\"email\" value={formData.email} onChange={(e) => setFormData({ ...formData, email: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n              </div>\n              <div>\n                <label className=\"text-slate-400\">Phone</label>\n                <input required type=\"text\" value={formData.phone} onChange={(e) => setFormData({ ...formData, phone: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-slate-400\">Designation</label>\n                  <input required type=\"text\" value={formData.designation} onChange={(e) => setFormData({ ...formData, designation: e.target.value })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n                <div>\n                  <label className=\"text-slate-400\">Salary (Monthly \342\202\271)</label>\n                  <input required type=\"number\" value={formData.salary} onChange={(e) => setFormData({ ...formData, salary: Number(e.target.value) })} className=\"w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1\" />\n                </div>\n              </div>\n              <div className=\"flex justify-end gap-2 pt-3 border-t border-slate-800\">\n                <button type=\"button\" onClick={() => setShowCreateModal(false)} className=\"px-4 py-2 bg-slate-800 text-slate-300 rounded-lg\">Cancel</button>\n                <button type=\"submit\" className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg\">Save Employee</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
