  file_change {
    absolute_path_uri: "file:///src/backend/database_v2/migrations/001_init.sql"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "-- THEIAKSHI ONE Enterprise HRMS - Database Schema Migration v2.0\n-- Target Engine: PostgreSQL 18+\n-- Scalability Level: 100,000+ Concurrent Employees\n\nBEGIN;\n\n-- 1. Custom Types & ENUMs\nCREATE TYPE employee_status AS ENUM (\'ACTIVE\', \'INACTIVE\', \'PROBATION\', \'SUSPENDED\', \'TERMINATED\', \'RESIGNED\');\nCREATE TYPE gender_type AS ENUM (\'MALE\', \'FEMALE\', \'NON_BINARY\', \'PREFER_NOT_TO_SAY\');\nCREATE TYPE attendance_status AS ENUM (\'PRESENT\', \'ABSENT\', \'HALF_DAY\', \'ON_LEAVE\', \'WEEK_OFF\', \'HOLIDAY\', \'LATE\', \'EARLY_DEPARTURE\');\nCREATE TYPE leave_workflow_status AS ENUM (\'DRAFT\', \'SUBMITTED\', \'MANAGER_PENDING\', \'HR_PENDING\', \'APPROVED\', \'REJECTED\', \'CANCELLED\');\nCREATE TYPE payroll_status AS ENUM (\'DRAFT\', \'PROCESSING\', \'APPROVED\', \'PAID\', \'ON_HOLD\', \'REJECTED\');\nCREATE TYPE expense_status AS ENUM (\'PENDING\', \'APPROVED\', \'REJECTED\', \'REIMBURSED\');\nCREATE TYPE priority_level AS ENUM (\'LOW\', \'MEDIUM\', \'HIGH\', \'CRITICAL\');\nCREATE TYPE task_status AS ENUM (\'TODO\', \'IN_PROGRESS\', \'IN_REVIEW\', \'COMPLETED\', \'BLOCKED\');\nCREATE TYPE ticket_status AS ENUM (\'OPEN\', \'IN_PROGRESS\', \'RESOLVED\', \'CLOSED\', \'REOPENED\');\nCREATE TYPE asset_status AS ENUM (\'AVAILABLE\', \'ASSIGNED\', \'UNDER_REPAIR\', \'DISPOSED\', \'LOST\');\n\n-- 2. Core Authentication & RBAC Tables\nCREATE TABLE roles (\n  id SERIAL PRIMARY KEY,\n  name VARCHAR(50) UNIQUE NOT NULL,\n  code VARCHAR(30) UNIQUE NOT NULL,\n  description TEXT,\n  is_system BOOLEAN DEFAULT false,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE permissions (\n  id SERIAL PRIMARY KEY,\n  module VARCHAR(50) NOT NULL,\n  action VARCHAR(50) NOT NULL,\n  code VARCHAR(100) UNIQUE NOT NULL,\n  description TEXT,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE role_permissions (\n  id SERIAL PRIMARY KEY,\n  role_id INTEGER NOT NULL REFERENCES roles(id) ON DELETE CASCADE,\n  permission_id INTEGER NOT NULL REFERENCES permissions(id) ON DELETE CASCADE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL,\n  CONSTRAINT uk_role_permission UNIQUE (role_id, permission_id)\n);\n\n-- 3. Organization Structure\nCREATE TABLE branches (\n  id SERIAL PRIMARY KEY,\n  name VARCHAR(100) NOT NULL,\n  code VARCHAR(20) UNIQUE NOT NULL,\n  address TEXT,\n  city VARCHAR(50),\n  state VARCHAR(50),\n  country VARCHAR(50) DEFAULT \'India\',\n  timezone VARCHAR(50) DEFAULT \'Asia/Kolkata\',\n  is_headquarters BOOLEAN DEFAULT false,\n  is_active BOOLEAN DEFAULT true,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE departments (\n  id SERIAL PRIMARY KEY,\n  branch_id INTEGER REFERENCES branches(id) ON DELETE SET NULL,\n  name VARCHAR(100) NOT NULL,\n  code VARCHAR(20) UNIQUE NOT NULL,\n  description TEXT,\n  manager_id INTEGER DEFAULT NULL,\n  is_active BOOLEAN DEFAULT true,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE designations (\n  id SERIAL PRIMARY KEY,\n  department_id INTEGER REFERENCES departments(id) ON DELETE SET NULL,\n  title VARCHAR(100) NOT NULL,\n  code VARCHAR(20) UNIQUE NOT NULL,\n  grade_level VARCHAR(20),\n  description TEXT,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE teams (\n  id SERIAL PRIMARY KEY,\n  department_id INTEGER REFERENCES departments(id) ON DELETE CASCADE,\n  lead_id INTEGER DEFAULT NULL,\n  name VARCHAR(100) NOT NULL,\n  code VARCHAR(20) UNIQUE NOT NULL,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE locations (\n  id SERIAL PRIMARY KEY,\n  branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n  name VARCHAR(100) NOT NULL,\n  latitude NUMERIC(10, 7),\n  longitude NUMERIC(10, 7),\n  radius_meters INTEGER DEFAULT 200,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE holidays (\n  id SERIAL PRIMARY KEY,\n  branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n  name VARCHAR(100) NOT NULL,\n  date DATE NOT NULL,\n  type VARCHAR(30) DEFAULT \'MANDATORY\',\n  description TEXT,\n  is_active BOOLEAN DEFAULT true,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE week_off_rules (\n  id SERIAL PRIMARY KEY,\n  branch_id INTEGER REFERENCES branches(id) ON DELETE CASCADE,\n  name VARCHAR(50) NOT NULL,\n  days_of_week VARCHAR(50) DEFAULT \'6,0\',\n  alternate_saturdays BOOLEAN DEFAULT false,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE shifts (\n  id SERIAL PRIMARY KEY,\n  name VARCHAR(50) NOT NULL,\n  code VARCHAR(20) UNIQUE NOT NULL,\n  start_time TIME NOT NULL,\n  end_time TIME NOT NULL,\n  break_duration_mins INTEGER DEFAULT 60,\n  grace_period_mins INTEGER DEFAULT 15,\n  is_night_shift BOOLEAN DEFAULT false,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\n-- 4. Employee Master Table\nCREATE TABLE employees (\n  id SERIAL PRIMARY KEY,\n  employee_code VARCHAR(20) UNIQUE NOT NULL,\n  email VARCHAR(100) UNIQUE NOT NULL,\n  password_hash VARCHAR(255) NOT NULL,\n  first_name VARCHAR(50) NOT NULL,\n  last_name VARCHAR(50) NOT NULL,\n  phone VARCHAR(20),\n  role VARCHAR(30) DEFAULT \'Employee\',\n  role_id INTEGER REFERENCES roles(id) ON DELETE SET NULL,\n  department_id INTEGER REFERENCES departments(id) ON DELETE SET NULL,\n  designation_id INTEGER REFERENCES designations(id) ON DELETE SET NULL,\n  branch_id INTEGER REFERENCES branches(id) ON DELETE SET NULL,\n  manager_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n  shift_id INTEGER REFERENCES shifts(id) ON DELETE SET NULL,\n  status VARCHAR(20) DEFAULT \'ACTIVE\',\n  gender VARCHAR(20) DEFAULT \'PREFER_NOT_TO_SAY\',\n  joining_date DATE NOT NULL,\n  birth_date DATE,\n  address TEXT,\n  avatar_url VARCHAR(255),\n  emergency_contact VARCHAR(20),\n  salary_amount NUMERIC(12,2) DEFAULT 0.00,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\n-- 5. Sessions, Tokens, & Security\nCREATE TABLE employee_sessions (\n  id SERIAL PRIMARY KEY,\n  employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n  session_token VARCHAR(255) UNIQUE NOT NULL,\n  ip_address VARCHAR(45),\n  user_agent TEXT,\n  expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE refresh_tokens (\n  id SERIAL PRIMARY KEY,\n  employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n  token VARCHAR(255) UNIQUE NOT NULL,\n  is_revoked BOOLEAN DEFAULT false,\n  expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE login_history (\n  id SERIAL PRIMARY KEY,\n  employee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,\n  email VARCHAR(100) NOT NULL,\n  status VARCHAR(20) NOT NULL,\n  ip_address VARCHAR(45),\n  user_agent TEXT,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE password_reset (\n  id SERIAL PRIMARY KEY,\n  employee_id INTEGER NOT NULL REFERENCES employees(id) ON DELETE CASCADE,\n  reset_token VARCHAR(255) UNIQUE NOT NULL,\n  is_used BOOLEAN DEFAULT false,\n  expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\nCREATE TABLE otp (\n  id SERIAL PRIMARY KEY,\n  employee_id INTEGER REFERENCES employees(id) ON DELETE CASCADE,\n  email_or_phone VARCHAR(100) NOT NULL,\n  otp_code VARCHAR(10) NOT NULL,\n  purpose VARCHAR(30) DEFAULT \'LOGIN\',\n  is_verified BOOLEAN DEFAULT false,\n  expires_at TIMESTAMP WITH TIME ZONE NOT NULL,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NULL,\n  created_by INTEGER DEFAULT NULL,\n  updated_by INTEGER DEFAULT NULL\n);\n\n-- Partial & B-Tree High Concurrency Indexes\nCREATE INDEX idx_employees_email ON employees(email) WHERE deleted_at IS NULL;\nCREATE INDEX idx_employees_code ON employees(employee_code) WHERE deleted_at IS NULL;\nCREATE INDEX idx_employees_dept ON employees(department_id) WHERE deleted_at IS NULL;\nCREATE INDEX idx_employees_branch ON employees(branch_id) WHERE deleted_at IS NULL;\nCREATE INDEX idx_employees_status ON employees(status) WHERE deleted_at IS NULL;\n\nCOMMIT;\n"
    }
