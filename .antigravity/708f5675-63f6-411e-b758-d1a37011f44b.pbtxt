    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export const HelpdeskPage: React.FC = () => {\n  const [tickets, setTickets] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchTickets = async () => {\n      try {\n        const res = await apiClient.get(\'/helpdesk\');\n        if (res.data?.success) setTickets(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchTickets();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <HelpCircle className=\"w-6 h-6 text-amber-400\" />\n            IT & HR Support Helpdesk\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Submit technical issues, access requests, or HR policy queries.</p>\n        </div>\n      </div>\n\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl\">\n        <table className=\"w-full text-left text-xs text-slate-300\">\n          <thead className=\"bg-slate-950 text-slate-400 uppercase text-[10px]\">\n            <tr>\n              <th className=\"p-4\">Ticket Code / Subject</th>\n              <th className=\"p-4\">Category</th>\n              <th className=\"p-4\">Requested By</th>\n              <th className=\"p-4\">Priority</th>\n              <th className=\"p-4\">Status</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {tickets.map((t) => (\n              <tr key={t.id} className=\"hover:bg-slate-800/40\">\n                <td className=\"p-4\">\n                  <p className=\"font-bold text-white\">{t.subject}</p>\n                  <p className=\"text-[10px] text-amber-400 font-mono\">{t.ticket_code}</p>\n                </td>\n                <td className=\"p-4 font-mono\">{t.category}</td>\n                <td className=\"p-4 font-medium text-slate-200\">{t.first_name} {t.last_name}</td>\n                <td className=\"p-4\">\n                  <span className=\"bg-amber-500/20 text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-500/30\">\n                    {t.priority}\n                  </span>\n                </td>\n                <td className=\"p-4\">\n                  <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">\n                    {t.status}\n                  </span>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n};\n\nexport const AnnouncementsPage: React.FC = () => {\n  const [announcements, setAnnouncements] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchAnn = async () => {\n      try {\n        const res = await apiClient.get(\'/announcements\');\n        if (res.data?.success) setAnnouncements(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchAnn();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Megaphone className=\"w-6 h-6 text-amber-400\" />\n            Corporate Announcements Broadcast\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Official updates from THEIAKSHI ENTERPRISES leadership.</p>\n        </div>\n      </div>\n\n      <div className=\"space-y-4\">\n        {announcements.map((a) => (\n          <div key={a.id} className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-2 shadow-lg\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"text-[10px] text-amber-400 font-mono uppercase font-bold\">{a.category}</span>\n              {a.is_pinned && <span className=\"bg-amber-500/20 text-amber-300 text-[9px] px-2 py-0.5 rounded font-mono font-bold\">PINNED BROADCAST</span>}\n            </div>\n            <h3 className=\"font-bold text-white text-base\">{a.title}</h3>\n            <p className=\"text-xs text-slate-300 leading-relaxed\">{a.content}</p>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "export const HelpdeskPage: React.FC = () => {\n  const [tickets, setTickets] = useState<any[]>([]);\n\n  useEffect(() => {\n    const fetchTickets = async () => {\n      try {\n        const res = await apiClient.get(\'/helpdesk\');\n        if (res.data?.success) setTickets(res.data.data);\n      } catch (e) { console.error(e); }\n    };\n    fetchTickets();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <HelpCircle className=\"w-6 h-6 text-amber-500\" />\n            IT & HR Support Helpdesk\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-1\">Submit technical issues, access requests, or HR policy queries.</p>\n        </div>\n      </div>\n\n      <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm\">\n        <table className=\"w-full text-left text-xs text-slate-700\">\n          <thead className=\"bg-slate-50 text-slate-500 uppercase text-[10px] font-black tracking-wider border-b border-slate-200\">\n            <tr>\n              <th className=\"p-4\">Ticket Code / Subject</th>\n              <th className=\"p-4\">Category</th>\n              <th className=\"p-4\">Requested By</th>\n              <th className=\"p-4\">Priority</th>\n              <th className=\"p-4\">Status</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {tickets.map((t) => (\n              <tr key={t.id} className=\"hover:bg-slate-50\">\n                <td className=\"p-4\">\n                  <p className=\"font-bold text-slate-900\">{t.subject}</p>\n                  <p className=\"text-[10px] text-amber-600 font-mono font-bold\">{t.ticket_code}</p>\n                </td>\n                <td cla