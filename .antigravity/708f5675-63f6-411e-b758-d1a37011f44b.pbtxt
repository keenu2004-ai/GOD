          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    b.name AS branch_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    COUNT(p.id) AS employee_count,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SUM(p.gross_earnings) AS total_gross_payout,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SUM(p.net_salary) AS total_net_payout,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SUM(p.pf_deduction + p.tax_deduction) AS total_deductions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  FROM payroll p"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  JOIN employees e ON p.employee_id = e.id"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  LEFT JOIN departments d ON e.department_id = d.id"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  LEFT JOIN branches b ON e.branch_id = b.id"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  WHERE p.deleted_at IS NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  GROUP BY p.year, p.month, d.name, b.name;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -- Department Headcount View"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  CREATE OR REPLACE VIEW v_department_headcount AS"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  SELECT "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    d.id AS department_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    d.name AS department_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    b.name AS branch_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    COUNT(e.id) AS total_headcount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SUM(CASE WHEN e.status = \'ACTIVE\' THEN 1 ELSE 0 END) AS active_headcount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SUM(e.salary_amount) AS total_monthly_payroll_expense"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  FROM departments d"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  LEFT JOIN branches b ON d.branch_id = b.id"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  LEFT JOIN employees e ON e.department_id = d.id AND e.deleted_at IS NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  WHERE d.deleted_at IS NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  GROUP BY d.id, d.name, b.name;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  `;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  await db.exec(viewsSQL);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
