    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { FolderGit2, Plus, CheckCircle, Clock, Check, X } from \'lucide-react\';\nimport apiClient from \'../services/apiClient.js\';\nimport { Project } from \'../types/index.js\';\n\nexport const ProjectsPage: React.FC = () => {\n  const [projects, setProjects] = useState<Project[]>([]);\n  const [loading, setLoading] = useState<boolean>(true);\n\n  const fetchProjects = async () => {\n    try {\n      setLoading(true);\n      const res = await apiClient.get(\'/projects\');\n      if (res.data?.success) setProjects(res.data.data);\n    } catch (e) {\n      console.error(e);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchProjects();\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 flex justify-between items-center\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <FolderGit2 className=\"w-6 h-6 text-indigo-400\" />\n            Projects & Task Delivery\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">Monitor active enterprise client projects, task completion, and budget allocations.</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {projects.map((proj) => (\n          <div key={proj.id} className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-xl\">\n            <div className=\"flex justify-between items-start\">\n              <div>\n                <span className=\"text-[10px] text-blue-400 font-mono font-bold uppercase\">{proj.code}</span>\n                <h3 className=\"font-bold text-white text-base mt-0.5\">{proj.name}</h3>\n                <p className=\"text-xs text-slate-400 mt-1\">{proj.description}</p>\n              </div>\n              <span className=\"bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30\">\n                {proj.status}\n              </span>\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between text-xs text-slate-300 font-mono\">\n                <span>Completion Progress:</span>\n                <span className=\"font-bold text-emerald-400\">{proj.progress}%</span>\n              </div>\n              <div className=\"w-full bg-slate-950 h-2.5 rounded-full overflow-hidden border border-slate-800\">\n                <div className=\"bg-emerald-500 h-full transition-all\" style={{ width: `${proj.progress}%` }}></div>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3 pt-3 border-t border-slate-800/80 text-xs font-mono\">\n              <div className=\"bg-slate-950 p-2.5 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-500 text-[10px]\">CLIENT:</span>\n                <p className=\"font-bold text-white\">{proj.client_name}</p>\n              </div>\n              <div className=\"bg-slate-950 p-2.5 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-500 text-[10px]\">BUDGET ALLOCATION:</span>\n                <p className=\"font-bold text-emerald-400\">\342\202\271{Number(proj.budget).toLocaleString(\'en-IN\')}</p>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
